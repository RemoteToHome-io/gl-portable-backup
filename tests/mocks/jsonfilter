#!/usr/bin/env python3
import sys, json, re
args = sys.argv[1:]; src = None; exprs = []
i = 0
while i < len(args):
    if args[i] == '-i': src = args[i+1]; i += 2
    elif args[i] == '-e': exprs.append(args[i+1]); i += 2
    else: i += 1
try:
    data = json.load(open(src)) if src else json.load(sys.stdin)
except Exception:
    print("Failed to parse json data", file=sys.stderr); sys.exit(1)
rc = 1
for e in exprs:
    cur = data; ok = True
    for tok in re.findall(r'\[(\d+)\]|\.?([A-Za-z0-9_-]+)', e.lstrip('@')):
        idx, key = tok
        try: cur = cur[int(idx)] if idx else cur[key]
        except Exception: ok = False; break
    if ok:
        rc = 0
        print(cur if isinstance(cur, str) else json.dumps(cur, separators=(',', ':')))
sys.exit(rc)
