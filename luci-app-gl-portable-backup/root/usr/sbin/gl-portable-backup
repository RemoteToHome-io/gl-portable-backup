#!/bin/sh
# GL Portable Backup
# Copyright (c) 2026 RemoteToHome Consulting — https://remotetohome.io
# Licensed under the GNU General Public License v3.0 or later
#
# Usage:
#   gl-portable-backup create [--mode clone|remote-safe|profile|full] [--output PATH]
#                             [--notes TEXT] [--include-plugins]
#   gl-portable-backup restore [--keep-host-keys] ARCHIVE
#   gl-portable-backup inspect ARCHIVE
#   gl-portable-backup fingerprint ARCHIVE
#   gl-portable-backup -v|--verbose <command> ...   (prints each local API call; must come first)

set -e

VERSION="1.1.0"
FORMAT_VERSION=4
TOOL_NAME="gl-portable-backup"
ARCHIVE_PREFIX="gl-portable-backup"

# Filesystem prefix for tests (empty on the router). Every capture/restore path below uses it.
ROOT="${GPB_ROOT:-}"
GPB_VERBOSE="${GPB_VERBOSE:-0}"
vlog() { [ "$GPB_VERBOSE" = 1 ] && echo "  [v] $*" >&2; return 0; }

# Remote-access config files excluded in remote-safe mode (entire files)
REMOTE_SAFE_EXCLUDE_FILES="zerotier tailscale gl-cloud rtty dropbear wan-access"

# Network interface names excluded in remote-safe mode
REMOTE_SAFE_EXCLUDE_IFACES="zerotier tailscale wwan wwan6 tethering tethering6"

# Firewall name prefixes excluded in remote-safe mode
REMOTE_SAFE_EXCLUDE_FW_PREFIXES="zerotier tailscale"

# ─── Utility Functions ────────────────────────────────────────────────────────

die() {
    echo "ERROR: $*" >&2
    exit 1
}

get_model_id() {
    jsonfilter -i "$ROOT/etc/board.json" -e '@.model.id'
}

get_model_name() {
    jsonfilter -i "$ROOT/etc/board.json" -e '@.model.name'
}

get_model_short_from_id() { printf '%s' "$1" | sed 's/glinet,//' | tr 'a-z' 'A-Z' | sed 's/-SNAND//'; }
get_model_short() { get_model_short_from_id "$(get_model_id)"; }

get_fw_version() {
    cat "$ROOT/etc/glversion" 2>/dev/null || echo "unknown"
}

# A missing file given to `.` is fatal in a non-interactive POSIX shell — 2>/dev/null hides the
# message, not the exit — so the read is guarded rather than tolerated.
get_openwrt_version() {
    [ -f "$ROOT/etc/openwrt_release" ] && . "$ROOT/etc/openwrt_release"
    echo "${DISTRIB_RELEASE:-unknown}"
}

get_architecture() {
    [ -f "$ROOT/etc/openwrt_release" ] && . "$ROOT/etc/openwrt_release"
    echo "${DISTRIB_ARCH:-unknown}"
}

get_hostname() {
    uci -q get system.@system[0].hostname 2>/dev/null || cat "$ROOT/proc/sys/kernel/hostname"
}

get_timestamp() {
    date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date +%Y-%m-%dT%H:%M:%SZ
}

get_datestamp() {
    date +%Y%m%d-%H%M
}

# Make a value safe to sit inside a JSON string literal. Backslash first, or the escape added for
# a quote would itself be escaped. A newline cannot be expressed this way — callers reject one.
json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

resolve_output_path() {
    local out="$1" name="$2"
    if [ -z "$out" ]; then echo "/tmp/$name"
    elif [ -d "$out" ]; then echo "${out%/}/$name"
    else echo "$out"; fi
}

# ─── GL.iNet Local API Helper ─────────────────────────────────────────────────

gl_auth() {
    local challenge nonce shadow_hash login_str login_hash result rc
    # Status is captured with "|| rc=$?": under dash, errexit propagates into $(...) and would
    # abort this function before a following "rc=$?" ran (verified 2026-09-12 on dash, busybox
    # sh, router ash).
    rc=0; challenge=$(curl -sf "http://127.0.0.1/rpc" \
        -d '{"jsonrpc":"2.0","id":1,"method":"challenge","params":{"username":"root"}}') || rc=$?
    if [ $rc -ne 0 ] || [ -z "$challenge" ]; then echo "auth: challenge failed (curl exit $rc) — is the GL web service (nginx /rpc) running?" >&2; return 1; fi
    nonce=$(echo "$challenge" | jsonfilter -e '@.result.nonce' 2>/dev/null) || { echo "auth: challenge reply has no nonce: $(printf '%s' "$challenge" | head -c 200)" >&2; return 1; }
    # Guarded the same way: an unreadable or missing shadow file must not abort silently, and an
    # empty hash must not reach the login step, where it would surface later as a misleading
    # "login refused".
    shadow_hash=$(awk -F: '/^root/{print $2}' "$ROOT/etc/shadow" 2>/dev/null) || shadow_hash=""
    [ -n "$shadow_hash" ] || { echo "auth: no password hash for root in $ROOT/etc/shadow (is the admin password set?)" >&2; return 1; }
    login_str="root:${shadow_hash}:${nonce}"
    if echo "$challenge" | grep -q '"hash-method":"sha256"'; then login_hash=$(printf "%s" "$login_str" | sha256sum | awk '{print $1}')
    else login_hash=$(printf "%s" "$login_str" | md5sum | awk '{print $1}'); fi
    rc=0; result=$(curl -sf "http://127.0.0.1/rpc" \
        -d "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"login\",\"params\":{\"username\":\"root\",\"hash\":\"$login_hash\"}}") || rc=$?
    [ $rc -eq 0 ] || { echo "auth: login request failed (curl exit $rc)" >&2; return 1; }
    echo "$result" | jsonfilter -e '@.result.sid' 2>/dev/null && return 0
    echo "auth: login refused: $(printf '%s' "$result" | head -c 200)" >&2
    return 1
}

gl_api() {
    local sid="$1" module="$2" method="$3" params="${4-}"
    [ -n "$params" ] || params='{}'
    vlog "rpc $module.$method $params"
    curl -sf "http://127.0.0.1/rpc" \
        -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"call\",\"params\":[\"$sid\",\"$module\",\"$method\",$params]}"
}

# Re-initialize DDNS after any restore mode.
#
# Problem: After a restore (any mode), the DDNS service won't start working
# until toggled via the GL admin panel. The GL GUI's "enable DDNS" API call
# initializes the device identity but resets custom operational preferences
# (check_interval, force_interval) to defaults.
#
# Solution: Save prefs → API enable (initializes identity) → re-apply prefs.
# Works for all modes:
#   - Clone/Remote-Safe: identity fields were stripped, API creates new ones
#   - Full: identity fields are intact, API re-registers them with the service
reinitialize_ddns() {
    local tmpdir="$1"

    [ -f "$tmpdir/config/gl_ddns" ] || return 0

    echo "  Initializing DDNS..." >&2

    # Save operational preferences from the restored config
    local ddns_prefs=$(mktemp -d)
    for section in glddns glddnsv6; do
        for field in check_interval check_unit force_interval force_unit; do
            uci -q get gl_ddns.${section}.${field} > "$ddns_prefs/${section}_${field}" 2>/dev/null || true
        done
    done

    # Authenticate and enable DDNS via API (initializes/re-registers device identity). The
    # preference re-apply and service restart below always run — even when auth fails — so a
    # restore leaves DDNS in a consistent state; only the API-driven identity registration is
    # skipped on failure.
    local sid
    if sid=$(gl_auth); then
        gl_api "$sid" "ddns" "set_config" '{"enable_ddns":true}' >/dev/null 2>&1 || echo "  WARNING: ddns.set_config failed" >&2
        echo "  DDNS enabled with device identity" >&2
    else
        echo "  WARNING: local API auth failed — DDNS not re-initialised via API (service restart still runs)" >&2
    fi

    # Re-apply backed-up operational preferences (API enable resets these)
    for section in glddns glddnsv6; do
        for field in check_interval check_unit force_interval force_unit; do
            local val=$(cat "$ddns_prefs/${section}_${field}" 2>/dev/null)
            [ -n "$val" ] && uci -q set gl_ddns.${section}.${field}="$val"
        done
    done
    uci commit gl_ddns 2>/dev/null || true
    /etc/init.d/gl_ddns restart 2>/dev/null || true
    echo "  DDNS operational preferences restored" >&2

    rm -rf "$ddns_prefs"
}

# ─── Hardware Identity ─────────────────────────────────────────────────────────

capture_hardware_ids() {
    local outfile="$1"
    local mac_lan mac_wan label_mac mac_wifi ddns_user ddns_domain ddns_param

    # LAN/WAN MACs from board.json
    mac_lan=$(jsonfilter -i "$ROOT/etc/board.json" -e '@.network.lan.macaddr' 2>/dev/null || echo "")
    mac_wan=$(jsonfilter -i "$ROOT/etc/board.json" -e '@.network.wan.macaddr' 2>/dev/null || echo "")
    label_mac=$(jsonfilter -i "$ROOT/etc/board.json" -e '@.system.label_macaddr' 2>/dev/null || echo "")

    # Wi-Fi MACs from wireless config
    mac_wifi=""
    local iface_macs
    iface_macs=$(grep 'option macaddr' "$ROOT/etc/config/wireless" 2>/dev/null | awk '{print $3}' | tr -d "'" | sort -u)
    for m in $iface_macs; do
        if [ -n "$mac_wifi" ]; then
            mac_wifi="${mac_wifi}, \"${m}\""
        else
            mac_wifi="\"${m}\""
        fi
    done

    # DDNS identity
    ddns_user=$(uci -q get gl_ddns.glddns.username 2>/dev/null || echo "")
    ddns_domain=$(uci -q get gl_ddns.glddns.domain 2>/dev/null || echo "")
    ddns_param=$(uci -q get gl_ddns.glddns.param_enc 2>/dev/null || echo "")

    cat > "$outfile" <<EOF
{
  "mac_lan": "${mac_lan}",
  "mac_wan": "${mac_wan}",
  "label_macaddr": "${label_mac}",
  "mac_wifi": [${mac_wifi}],
  "ddns_username": "${ddns_user}",
  "ddns_domain": "${ddns_domain}",
  "ddns_param_enc": "${ddns_param}",
  "board_json": $(cat "$ROOT/etc/board.json")
}
EOF
}

# ─── Persistent Files (keep.d + sysupgrade.conf + changed conffiles) ──────────

# Enumerate every path OpenWrt's own sysupgrade preserves: the /lib/upgrade/keep.d/*
# declarations (files, directories and glob patterns), /etc/sysupgrade.conf, and the conffiles
# opkg reports as locally changed. Reading only keep.d misses the other two sources.
# Output: one absolute path per line, existing regular files only, sorted and deduplicated.
enumerate_persistent_paths() {
    {
        for keepfile in "$ROOT"/lib/upgrade/keep.d/* "$ROOT/etc/sysupgrade.conf"; do
            [ -f "$keepfile" ] || continue
            while IFS= read -r line || [ -n "$line" ]; do
                line=$(printf '%s' "$line" | sed 's/#.*//; s/^[ \t]*//; s/[ \t]*$//')
                [ -n "$line" ] || continue
                for p in "$ROOT"$line; do   # unquoted: expands keep.d globs
                    if [ -d "$p" ]; then find "$p" -type f 2>/dev/null || true
                    elif [ -f "$p" ]; then printf '%s\n' "$p"
                    fi
                done
            done < "$keepfile"
        done
        # A read failure here must never truncate the list silently, so the whole pipeline is
        # tolerated: opkg may be absent, and a conffile may be unreadable.
        opkg list-changed-conffiles 2>/dev/null | while IFS= read -r c; do
            [ -f "$ROOT$c" ] && printf '%s\n' "$ROOT$c"
        done || true
    } | sed "s|^$ROOT||" | sort -u
}

# Back up user configuration, not router functionality. Firmware-owned paths — engine state,
# vendor scripts, package-manager bookkeeping, generated caches — are recreated by the target's
# own firmware, so carrying them across only pushes the source's copy of a router component over
# the target's. Everything outside /etc gets the same treatment: those are the binaries and
# libraries of installed packages, not settings. --include-plugins opts them back in.
is_firmware_owned() {
    # Outside /etc: binaries, libraries and plugin files — functionality, not config.
    case "$1" in
        /etc/*) ;;
        *) [ "${GPB_INCLUDE_PLUGINS:-0}" = 1 ] && return 1; return 0 ;;
    esac
    # opkg's *-opkg conffile backups are dropped in cmd_create; /etc/config never reaches here.
    case "$1" in
        /etc/netifyd/*|/etc/udhcpc.user.d/*|/etc/openvpn/scripts/*|/etc/gl_crontabs/crontabs.d/modem_*|\
        /etc/backup/installed_packages.txt|/etc/xattr.conf|/etc/fw_env.config|/etc/luci-uploads/*|\
        /etc/domain_mac_list/*|/etc/opkg/keys/*|/etc/ssmtp/*|/etc/oui/oui.db) return 0 ;;
    esac
    return 1
}

# A file byte-identical to the firmware's own copy under /rom is one nobody ever edited. Skipping
# it keeps the archive to what the user actually changed, and leaves the target free to keep the
# version its own firmware shipped — which matters most when restoring onto newer firmware.
is_rom_identical() { [ -f "$ROOT/rom$1" ] && cmp -s "$ROOT$1" "$ROOT/rom$1"; }

# Capture the non-UCI persistent files discovered by enumerate_persistent_paths
# Applies mode-specific filtering, copies to extra/ in archive
# Outputs one line: "<captured> <firmware-owned skipped> <rom-identical skipped> <hidden skipped>"
capture_extra_files() {
    local archdir="$1"
    local mode="$2"
    local extradir="$archdir/extra"
    local skipped_owned=0
    local skipped_rom=0
    local skipped_hidden=0

    mkdir -p "$extradir"

    # Write filtered paths to a temp file to avoid subshell count loss
    local pathlist=$(mktemp)
    enumerate_persistent_paths > "$pathlist"

    while IFS= read -r filepath; do
        # Skip /etc/config/ — already captured in config/
        case "$filepath" in /etc/config/*) continue ;; esac

        # A dot-named component hides an entry from a plain ls, which is where a foothold on a
        # compromised router hides; the same rule as for /etc/config, and restore refuses them too.
        case "$filepath" in */.*) skipped_hidden=$((skipped_hidden + 1)); vlog "skip hidden $filepath"; continue ;; esac

        # Router functionality rather than user configuration, and files nobody ever edited:
        # neither belongs in a configuration archive. Both counts reach backup-info.txt.
        is_firmware_owned "$filepath" && { skipped_owned=$((skipped_owned + 1)); vlog "skip firmware-owned $filepath"; continue; }
        is_rom_identical "$filepath" && { skipped_rom=$((skipped_rom + 1)); vlog "skip rom-identical $filepath"; continue; }

        # System identity files belong to the device rather than to a portable configuration,
        # so only Full mode — disaster recovery of this same unit — keeps them.
        if [ "$mode" != "full" ]; then
            case "$filepath" in
                /etc/shadow|/etc/passwd|/etc/group|/etc/hosts|\
                /etc/shells|/etc/shinit|/etc/profile|/etc/inittab|\
                /etc/sysctl.conf|/etc/rc.local) continue ;;
            esac
        fi

        # Clone + Remote-Safe: exclude device-generated TLS/SSH keys and per-device node identity.
        # /etc/tailscale/ holds tailscaled.state, i.e. this unit's Tailscale node private key —
        # same-device identity, like the host keys beside it, so the target re-authenticates
        # instead of inheriting the source's node.
        if [ "$mode" = "clone" ] || [ "$mode" = "remote-safe" ]; then
            case "$filepath" in
                /etc/dropbear/dropbear_*_host_key) continue ;;
                /etc/uhttpd.crt|/etc/uhttpd.key) continue ;;
                /etc/nginx/nginx.cer|/etc/nginx/nginx.key) continue ;;
                /etc/tailscale/*) continue ;;
            esac
        fi

        # Remote-Safe: also exclude remote-access state
        if [ "$mode" = "remote-safe" ]; then
            case "$filepath" in
                /etc/dropbear/authorized_keys) continue ;;
            esac
        fi

        # Copy file preserving directory structure
        local relpath="${filepath#/}"
        local destdir="$extradir/$(dirname "$relpath")"
        mkdir -p "$destdir"
        cp -a "$ROOT$filepath" "$destdir/"
    done < "$pathlist"

    rm -f "$pathlist"

    # One line, four integers: captured, firmware-owned skipped, rom-identical skipped, hidden
    # skipped. The captured count comes from the archive itself (avoids subshell variable loss).
    local captured
    captured=$(find "$extradir" -type f 2>/dev/null | wc -l)
    printf '%s %s %s %s\n' "$((captured))" "$skipped_owned" "$skipped_rom" "$skipped_hidden"
}

# ─── SSH Host Keys ────────────────────────────────────────────────────────────

# True when the archive carries the source unit's dropbear host keys — the files that decide
# which SSH identity this unit presents. Only Full mode captures them; Clone and Remote-Safe
# strip them at capture time.
archive_has_host_keys() {
    [ -f "$1/extra/etc/dropbear/dropbear_ed25519_host_key" ] \
        || [ -f "$1/extra/etc/dropbear/dropbear_rsa_host_key" ] \
        || [ -f "$1/extra/etc/dropbear/dropbear_ecdsa_host_key" ]
}

# The fingerprint an SSH client sees once the archive's host keys are in place. Prints nothing when
# the archive carries none. The key types are tried in the order a client prefers them, and the
# list matches the one archive_has_host_keys tests, so an archive carrying only an ecdsa key still
# reports a fingerprint rather than warning about a key it cannot name.
archive_hostkey_fingerprint() {
    local d="$1/extra/etc/dropbear" k
    for k in dropbear_ed25519_host_key dropbear_rsa_host_key dropbear_ecdsa_host_key; do
        if [ -f "$d/$k" ]; then
            dropbearkey -y -f "$d/$k" 2>/dev/null | grep -i fingerprint
            return 0
        fi
    done
    return 0
}

# Restore extra/ files from archive to filesystem. Prints the number of files restored; one
# warning line on stderr for each kind of entry that was NOT restored: anything under etc/config/
# (configuration comes from config/ only), anything with a dot-named component, and anything that is
# not a regular file (symlinks above all — a link could point anywhere). Returns 1 when a directory
# or a copy fails, so the caller stops instead of reporting a restore that did not happen.
restore_extra_files() {
    local tmpdir="$1"
    [ -d "$tmpdir/extra" ] || { echo 0; return 0; }

    # The relative paths go through a file and are read one line at a time. A `for f in $(find …)`
    # form would word-split a name holding a space and pathname-expand one holding * or ?, so the
    # copy aborted part-way through a restore and the count counted the fragments. Reading from a
    # file rather than a pipe also keeps the loop in this shell, so the count survives it — the
    # same pattern capture_extra_files uses.
    local pathlist
    pathlist=$(mktemp) || return 1
    (cd "$tmpdir/extra" && find . ! -type d | sed 's|^\./||') > "$pathlist" || { rm -f "$pathlist"; return 1; }

    local count=0 n_conf=0 n_hidden=0 n_other=0
    local relfile destdir
    while IFS= read -r relfile; do
        if [ -L "$tmpdir/extra/$relfile" ] || [ ! -f "$tmpdir/extra/$relfile" ]; then
            n_other=$((n_other + 1)); continue
        fi
        if extra_rel_skipped "$relfile"; then
            case "$relfile" in etc/config/*) n_conf=$((n_conf + 1)) ;; *) n_hidden=$((n_hidden + 1)) ;; esac
            continue
        fi
        # --keep-host-keys leaves this unit's SSH identity alone. authorized_keys is never
        # skipped: which keys may log in is user configuration, the host key is identity.
        case "$relfile" in
            etc/dropbear/dropbear_*_host_key) [ "${GPB_KEEP_HOST_KEYS:-0}" = 1 ] && continue ;;
        esac
        destdir="$ROOT/$(dirname "$relfile")"
        mkdir -p "$destdir" || { rm -f "$pathlist"; return 1; }
        cp -a "$tmpdir/extra/$relfile" "$ROOT/$relfile" || { rm -f "$pathlist"; return 1; }
        count=$((count + 1))
    done < "$pathlist"

    rm -f "$pathlist"
    [ "$n_conf" -eq 0 ] || echo "  WARNING: ${n_conf} entries under extra/etc/config/ in this archive were NOT restored" >&2
    [ "$n_hidden" -eq 0 ] || echo "  WARNING: ${n_hidden} hidden entries under extra/ in this archive were NOT restored" >&2
    [ "$n_other" -eq 0 ] || echo "  WARNING: ${n_other} symbolic links or other non-regular entries under extra/ in this archive were NOT restored" >&2
    echo "$count"
}

# ─── Sanitize (Strip Hardware IDs) ────────────────────────────────────────────

sanitize_configs() {
    local confdir="$1"

    # Strip MAC addresses from network device sections
    [ -f "$confdir/network" ] && sed -i "/option macaddr/d" "$confdir/network"

    # Strip Wi-Fi interface MACs
    [ -f "$confdir/wireless" ] && sed -i "/option macaddr/d" "$confdir/wireless"

    # Strip per-device MAC fields added by firmware 4.9/4.11 (factory_macaddr, repeater, port map)
    [ -f "$confdir/wireless" ] && sed -i "/option factory_macaddr/d" "$confdir/wireless"
    [ -f "$confdir/repeater" ] && sed -i "/option macaddr/d" "$confdir/repeater"
    [ -f "$confdir/eth_ports_config_map" ] && sed -i "/option default_mac/d" "$confdir/eth_ports_config_map"

    # Strip DDNS device-specific fields (both v4 and v6)
    # enabled is stripped because DDNS activation requires user consent via GUI
    # and the hostname is tied to the device ID (<gl-device-id>.glddns.com)
    if [ -f "$confdir/gl_ddns" ]; then
        for field in enabled username domain param_enc lookup_host password; do
            sed -i "/option ${field}/d" "$confdir/gl_ddns"
        done
    fi

    # Strip WireGuard server keys
    if [ -f "$confdir/wireguard_server" ]; then
        sed -i "/option private_key/d" "$confdir/wireguard_server"
        sed -i "/option public_key/d" "$confdir/wireguard_server"
        sed -i "/option preshared_key/d" "$confdir/wireguard_server"
        sed -i "/option presharedkey/d" "$confdir/wireguard_server"
    fi

    # Strip WireGuard client keys (GL.iNet WG client peer configs)
    if [ -f "$confdir/wireguard" ]; then
        sed -i "/option private_key/d" "$confdir/wireguard"
        sed -i "/option public_key/d" "$confdir/wireguard"
        sed -i "/option preshared_key/d" "$confdir/wireguard"
    fi

    # Strip AmneziaWG/WireGuard client keys from network config
    if [ -f "$confdir/network" ]; then
        sed -i "/option private_key/d" "$confdir/network"
        sed -i "/option public_key/d" "$confdir/network"
        sed -i "/option preshared_key/d" "$confdir/network"
    fi

    # Strip the ZeroTier node identity. Firmware 4.9+ mirrors the node's private key into UCI as
    # zerotier.gl.secret; two units restored from one archive would otherwise share one ZT node
    # identity and collide on the network. The join ID stays — which network to join is the
    # deployment setting being cloned, and GL generates a fresh identity when the field is absent.
    [ -f "$confdir/zerotier" ] && sed -i "/option secret/d" "$confdir/zerotier"

    # Strip OpenVPN client credentials
    if [ -f "$confdir/ovpnclient" ]; then
        sed -i "/option username/d" "$confdir/ovpnclient"
        sed -i "/option password/d" "$confdir/ovpnclient"
    fi
}

# ─── Remote-Safe Filtering ────────────────────────────────────────────────────

# Remove entire config files that are remote-access-specific
exclude_remote_access_files() {
    local confdir="$1"
    local f
    for f in $REMOTE_SAFE_EXCLUDE_FILES; do
        rm -f "$confdir/$f"
    done
}

# Filter network config: remove interface sections for remote-access services
filter_network_remote_safe() {
    local infile="$1"
    local tmpfile="${infile}.filtered"

    [ -f "$infile" ] || return 0

    awk -v excludes="$REMOTE_SAFE_EXCLUDE_IFACES" '
    BEGIN {
        split(excludes, exc_arr, " ")
        for (i in exc_arr) exc[exc_arr[i]] = 1
        skip = 0
    }
    /^config / {
        skip = 0
        # Check if this is an interface section with an excluded name
        if ($2 == "interface") {
            name = $3
            gsub(/'\''/, "", name)
            if (name in exc) skip = 1
        }
        # Check config device sections that reference excluded interfaces
        if ($2 == "device") {
            # We will check the name in subsequent lines
            pending_device = 1
            device_lines = $0 "\n"
            next
        }
    }
    pending_device {
        device_lines = device_lines $0 "\n"
        if (/option name/) {
            name = $3
            gsub(/'\''/, "", name)
            # Skip device blocks for ZT/TS interfaces (e.g., zt* devices)
            for (e in exc) {
                if (index(name, substr(e, 1, 2)) == 1) {
                    skip = 1
                }
            }
            if (!skip) printf "%s", device_lines
            pending_device = 0
            device_lines = ""
            next
        }
        if (/^config / || /^$/) {
            if (!skip) printf "%s", device_lines
            pending_device = 0
            device_lines = ""
            skip = 0
        }
        next
    }
    !skip { print }
    ' "$infile" > "$tmpfile"

    mv "$tmpfile" "$infile"
}

# Filter firewall config: remove zones/rules/forwards for remote-access services
filter_firewall_remote_safe() {
    local infile="$1"
    local tmpfile="${infile}.filtered"

    [ -f "$infile" ] || return 0

    awk -v prefixes="$REMOTE_SAFE_EXCLUDE_FW_PREFIXES" '
    BEGIN {
        split(prefixes, pfx_arr, " ")
        skip = 0
    }
    /^config / {
        skip = 0
        # Get the name (3rd field, may be quoted)
        name = $3
        gsub(/'\''/, "", name)
        # Check each prefix
        for (i in pfx_arr) {
            if (index(name, pfx_arr[i]) == 1) {
                skip = 1
                break
            }
        }
    }
    !skip { print }
    ' "$infile" > "$tmpfile"

    mv "$tmpfile" "$infile"
}

# ─── Profile Mode (API-Based) ─────────────────────────────────────────────────

# The local API surface differs by firmware and by model: 4.11 dropped the `lan` module in
# favour of `vlan_subnet`, and no model ships every module. The RPC handler directory is the
# authoritative list — a bare file for a Lua module, NAME.so for a compiled one.
api_module_present() { [ -e "$ROOT/usr/lib/oui-httpd/rpc/$1" ] || [ -e "$ROOT/usr/lib/oui-httpd/rpc/$1.so" ]; }

# Capture one getter. A module this firmware does not ship is skipped. A JSON-RPC reply carries
# either "result" or "error" at its top level, and only a "result" reply is data worth storing;
# anything else is reported instead. Testing for "error" would be wrong twice over: a result of
# its own may carry an "error" field, and the "message" printed for it would then come out of the
# result body — which on wifi.get_config is SSIDs and keys, and stderr is no place for those.
capture_api() {   # sid module method outfile
    local reply msg
    api_module_present "$2" || { vlog "module $2 absent — skipping $2.$3"; return 0; }
    reply=$(gl_api "$1" "$2" "$3") || { echo "  WARNING: $2.$3: transport failure" >&2; return 0; }
    if printf '%s' "$reply" | grep -q '"result"'; then printf '%s' "$reply" > "$4"; return 0; fi
    msg=$(printf '%s' "$reply" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p' | head -c 200)
    echo "  WARNING: $2.$3: ${msg:-$(printf '%s' "$reply" | head -c 120)}" >&2
}

# Remove every "FIELD":"value" pair (string values without quotes) from a stored JSON reply,
# together with exactly one adjacent comma, so the result is valid JSON whether the field is
# first, middle, last or alone in its object. Whitespace around the colon and comma is allowed.
# Newlines become spaces first so a comma on the neighbouring line is still adjacent. FIELD is
# used as written inside a sed pattern: call it with plain names only. A missing file is a no-op.
strip_json_string_field() {   # file field
    local tmp
    [ -f "$1" ] || return 0
    tmp="$1.strip.$$"
    tr '\n' ' ' < "$1" | sed \
        -e 's/[ ]*,[ ]*"'"$2"'"[ ]*:[ ]*"[^"]*"//g' \
        -e 's/"'"$2"'"[ ]*:[ ]*"[^"]*"[ ]*,[ ]*//g' \
        -e 's/"'"$2"'"[ ]*:[ ]*"[^"]*"//g' > "$tmp" || { rm -f "$tmp"; return 1; }
    mv "$tmp" "$1"
}

# One file per call, named module.method.json (format 4). Format 3 named files after the setting
# (wifi.json, dhcp_static_binds.json); restore reads either set — see api_file().
capture_profile() {
    local apidir="$1" sid
    mkdir -p "$apidir"
    sid=$(gl_auth) || die "Failed to authenticate to local API — see the line above"
    # LAN subnets and DHCP reservations live under `vlan_subnet` from 4.11 on, where a subnet
    # also carries its VLAN id, and under `lan` before that.
    if api_module_present vlan_subnet; then
        capture_api "$sid" vlan_subnet get_subnets "$apidir/vlan_subnet.get_subnets.json"
        capture_api "$sid" vlan_subnet get_static_bind_list "$apidir/vlan_subnet.get_static_bind_list.json"
    else
        capture_api "$sid" lan get_config_list "$apidir/lan.get_config_list.json"
        capture_api "$sid" lan get_static_bind_list "$apidir/lan.get_static_bind_list.json"
    fi
    # Profile carries one user's complete portable setup to a different model, secrets included:
    # vpn-client.get_all_config_list (every tunnel's private and pre-shared keys and OpenVPN
    # credentials) and repeater.get_saved_ap_list (the passwords of access points this router has
    # joined) are captured on purpose — they are the setup being moved, and the archive is handled
    # like a Full backup. Device identity stays out: cloud.get_config (this individual device's
    # GoodCloud binding) is deliberately absent from the list below, and so is system.get_info,
    # whose reply carries the serial number and the WAN MAC address.
    for mm in wifi.get_config dns.get_config dns.get_host firewall.get_rule_list firewall.get_port_forward_list \
              firewall.get_wan_access system.get_timezone_config led.get_config ipv6.get_ipv6 \
              cable.get_ports_config tailscale.get_config zerotier.get_config vpn-client.get_tunnel \
              vpn-client.get_all_config_list timer.get_wifi timer.get_led timer.get_reboot switch-button.get_config \
              repeater.get_saved_ap_list netmode.get_mode; do
        capture_api "$sid" "${mm%%.*}" "${mm#*.}" "$apidir/$mm.json"
    done
    # Hardware addresses inside the stored replies: the radios' own BSSIDs (wifi.get_config) and
    # each port's factory MAC (cable.get_ports_config "defmacaddr"). Deliberately NOT stripped:
    # "macaddr" in cable.get_ports_config and repeater.get_saved_ap_list, which are the user's
    # own MAC-mode settings (a cloned or randomised WAN or repeater address they configured).
    strip_json_string_field "$apidir/wifi.get_config.json" bssid
    strip_json_string_field "$apidir/cable.get_ports_config.json" defmacaddr
}

# ─── Package Capture ───────────────────────────────────────────────────────────

get_kernel_version() {
    awk '/^Package: kernel$/{found=1} found && /^Version:/{print $2; exit}' \
        "$ROOT/usr/lib/opkg/status" 2>/dev/null || echo "unknown"
}

# Capture user-installed packages with full metadata as JSON
capture_packages_json() {
    local outfile="$1"
    local kver arch

    kver=$(get_kernel_version)
    arch=$(get_architecture)

    awk -v kver="$kver" -v arch="$arch" '
    BEGIN {
        first = 1
        printf "{\n  \"format\": 1,\n"
        printf "  \"kernel_version\": \"%s\",\n", kver
        printf "  \"architecture\": \"%s\",\n", arch
        printf "  \"packages\": [\n"
    }

    /^$/ { flush(); next }

    /^Package:/       { pkg = substr($0, 10) }
    /^Version:/       { ver = substr($0, 10) }
    /^Section:/       { sec = substr($0, 10) }
    /^Architecture:/  { pkgarch = substr($0, 15) }
    /^Depends:/       { deps = substr($0, 10) }
    /^Installed-Size:/ { isize = substr($0, 17) }
    /^Installed-Time:/ { itime = substr($0, 17) }
    /^Description:/   { desc = substr($0, 14) }
    /^Status:.*user installed/ { user_installed = 1 }

    function flush() {
        if (pkg != "" && user_installed) {
            # Escape double quotes in string fields
            gsub(/"/, "\\\"", desc)
            gsub(/"/, "\\\"", deps)
            is_kmod = (sec == "kernel" || substr(pkg, 1, 5) == "kmod-") ? "true" : "false"
            if (!first) printf ",\n"
            first = 0
            printf "    {\n"
            printf "      \"name\": \"%s\",\n", pkg
            printf "      \"version\": \"%s\",\n", ver
            printf "      \"section\": \"%s\",\n", sec
            printf "      \"architecture\": \"%s\",\n", pkgarch
            printf "      \"description\": \"%s\",\n", desc
            printf "      \"depends\": \"%s\",\n", deps
            printf "      \"installed_size\": %s,\n", (isize != "" ? isize : "0")
            printf "      \"installed_time\": %s,\n", (itime != "" ? itime : "0")
            printf "      \"is_kmod\": %s\n", is_kmod
            printf "    }"
        }
        pkg = ""; ver = ""; sec = ""; pkgarch = ""; desc = ""; deps = ""
        isize = ""; itime = ""; user_installed = 0
    }

    END {
        flush()
        printf "\n  ]\n}\n"
    }
    ' "$ROOT/usr/lib/opkg/status" > "$outfile" 2>/dev/null
}

# Legacy name-only capture for backward compatibility
capture_packages_txt() {
    local outfile="$1"
    awk '/^Package:/{p=$2} /Status:.*user installed/{print p}' \
        "$ROOT/usr/lib/opkg/status" > "$outfile" 2>/dev/null || true
}

count_packages_json() {
    local n
    n=$(grep -c '"name":' "$1" 2>/dev/null) || true
    echo "${n:-0}"
}

# ─── Hidden Entries ────────────────────────────────────────────────────────────

# Delete every entry under $1 whose name starts with a dot, at any depth, files and directories
# alike, and print how many were deleted. -depth visits children before their parent, and find
# does not follow symlinks, so a hidden symlink is removed as a link, never through it. The count
# is one byte per deletion, so a name holding a newline cannot inflate it.
strip_hidden_entries() {
    find "$1" -depth -name '.*' -exec rm -rf {} \; -exec printf x \; | wc -c
}

# ─── Archive Member Checks ─────────────────────────────────────────────────────

# Every archive is attacker-controlled input restored as root, so what the archive holds is read from
# its listing before anything is extracted, and every decision taken from that listing goes through
# one normaliser. Filter: one member name per line in, the same name out with "//" collapsed, "/./"
# removed, leading "./" and "/" stripped (tar strips a leading "/" on extraction) and a trailing "/."
# turned into "/" (a directory stays recognisable by its trailing slash).
normalize_member_paths() {
    sed -e 's|//*|/|g' -e ':a' -e 's|/\./|/|g' -e 'ta' -e 's|^\(\./\)*||' -e 's|^/*||' \
        -e 's|/\.$|/|' -e 's|^\.$||'
}

# archive_precheck ARCHIVE LISTFILE — refuses, before any extraction, an archive whose listing:
#  - fails or is empty (absent is not clean);
#  - has a member whose type is not a regular file, directory or symlink — GNU tar prints a hard link
#    as "h", BusyBox tar as a regular-file line carrying " -> " (read on the router's BusyBox 1.33.2
#    and on desktop BusyBox 1.36.1); fifos and device nodes are "p", "b", "c". A regular file whose
#    own name contains " -> " is refused by the same rule, which is accepted: this tool never writes
#    one. Symlinks are tolerated here; they are never restored, and the top-level names below are
#    refused outright;
#  - has a member with a ".." component, a control character or a backslash (GNU tar prints control
#    characters as backslash escapes; under BusyBox a newline splits the name into a line that does
#    not start with a type character, which the type rule above refuses);
#  - holds a symlink where the tool reads its own files: the prefix directory, manifest.json, config,
#    extra, api, packages.json, packages.txt.
# Writes the normalised member list to LISTFILE. Every refusal names a count, never a member name.
archive_precheck() {   # archive listfile
    local a="$1" out="$2" res special unsafe toplink
    rm -f "$out" "$out.v"
    if ! tar -tzf "$a" > "$out.raw" 2>"$out.err" || ! tar -tvzf "$a" > "$out.v" 2>/dev/null || [ ! -s "$out.raw" ]; then
        rm -f "$out.raw" "$out.v" "$out.err"
        die "Invalid archive: it cannot be listed"
    fi
    normalize_member_paths < "$out.raw" > "$out"
    rm -f "$out.raw"
    # Desktop BusyBox tar (1.36.1) strips a "../" prefix while listing and says so on stderr, so the
    # listing alone would not show it; GNU tar lists the name as stored. Either form is refused.
    local stripped
    stripped=$(grep -c -i 'removing leading .*\.\.' "$out.err") || stripped=0
    rm -f "$out.err"
    res=$(awk -v pre="$ARCHIVE_PREFIX" '
        FILENAME == ARGV[1] {
            t = substr($0, 1, 1); type[FNR] = t
            if ((t != "-" && t != "d" && t != "l") || (t == "-" && index($0, " -> ") > 0)) special++
            next
        }
        {
            if ($0 ~ /[\001-\037\177\\]/ || ("/" $0 "/") ~ /\/\.\.\//) unsafe++
            if (type[FNR] == "l") {
                n = $0; sub(/\/$/, "", n)
                rel = n; if (index(rel, pre "/") == 1) rel = substr(rel, length(pre) + 2)
                if (n == pre) toplink = pre
                else if (rel == "manifest.json" || rel == "config" || rel == "extra" || rel == "api" || \
                         rel == "packages.json" || rel == "packages.txt") toplink = rel
            }
        }
        END { printf "%d %d %s\n", special, unsafe, (toplink == "" ? "-" : toplink) }
    ' "$out.v" "$out")
    rm -f "$out.v"
    set -- $res
    special=$1; unsafe=$2; toplink=$3
    [ "$unsafe" -gt 0 ] || unsafe=$stripped
    [ "$special" -eq 0 ] || die "Invalid archive: it contains $special hard links, device nodes or other special members"
    [ "$unsafe" -eq 0 ] || die "Invalid archive: $unsafe members have a '..' component, a control character or a backslash in their name"
    [ "$toplink" = "-" ] || die "Invalid archive: $toplink is a symbolic link"
    return 0
}

# After extraction: the prefix directory and the tool's own top-level entries must not be symlinks
# (the listing check above refuses them already; this reads the extracted tree itself), and no name
# anywhere may carry a newline, another control character or a backslash. A newline is caught by
# counting entries two ways — lines versus one byte per entry — since no line-based reader sees it.
assert_extracted_tree_safe() {   # extraction-dir base-dir
    local x="$1" base="$2" n
    [ -L "$x/$ARCHIVE_PREFIX" ] && die "Invalid archive: $ARCHIVE_PREFIX is a symbolic link"
    for n in manifest.json config extra api packages.json packages.txt; do
        [ -L "$base/$n" ] && die "Invalid archive: $n is a symbolic link"
    done
    [ "$(find "$x" | wc -l)" -eq "$(find "$x" -exec printf x \; | wc -c)" ] \
        || die "Invalid archive: a member name contains a newline"
    n=$(find "$x" | awk '/[\001-\037\177\\]/ { n++ } END { print n + 0 }')
    [ "$n" -eq 0 ] || die "Invalid archive: $n members have a control character or a backslash in their name"
    return 0
}

# The manifest layout this tool writes: an opening line, the keys, a closing brace alone on the last
# line. inspect appends its keys before that brace; anything else could hide them.
manifest_layout_ok() {
    [ -f "$1" ] && [ ! -L "$1" ] && [ "$(tail -n 1 "$1" | tr -d ' \t\r')" = "}" ] && [ "$(wc -l < "$1")" -ge 3 ]
}

# Paths under extra/ (relative, etc/...) that restore never writes: anything under etc/config/
# (configuration is restored from config/ only, and capture never puts a file there) and anything
# with a dot-named component at any depth. Shared by restore_extra_files and the flagged list, so
# the two can never disagree.
extra_rel_skipped() {
    case "$1" in etc/config/*|etc/config) return 0 ;; esac
    case "/$1" in */.*) return 0 ;; esac
    return 1
}

# ─── Compromise Markers ────────────────────────────────────────────────────────

# Paths that the cleanup script inside GL's published KVM firmware removes after the incident
# described in GL.iNet Security Notice 2026-11-20. GL has published no such list for routers, so
# this is not one: finding none of these proves nothing about the router, and finding one is not
# proof of compromise. Prints each path that exists under $ROOT, one per line.
suspect_markers() {
    local p
    for p in /etc/config/.gl /etc/glinet/.cache; do
        if [ -e "$ROOT$p" ] || [ -L "$ROOT$p" ]; then printf '%s\n' "$p"; fi
    done
    return 0
}

# True when $1, a path relative to the archive's extra/ directory (etc/...), is a file that runs at
# boot or decides who may log in — the places a foothold persists. A directory member (trailing
# slash) never matches; `*` in a case pattern also matches a slash, so nested files under the
# listed directories match.
is_startup_or_login() {
    case "$1" in
        */) return 1 ;;
        etc/rc.local|etc/crontabs/*|etc/dropbear/authorized_keys|etc/shadow|etc/passwd|etc/group|\
        etc/init.d/*|etc/rc.d/*|etc/hotplug.d/*|etc/uci-defaults/*|etc/sysupgrade.conf|\
        etc/profile|etc/profile.d/*|etc/dropbear/dropbear_*_host_key|\
        etc/rc.button/*|etc/firewall.user|etc/sysctl.conf|etc/sysctl.d/*|etc/inittab|etc/opkg/*|\
        etc/hotplug-preinit.d/*|etc/rc.common|etc/preinit) return 0 ;;
    esac
    return 1
}

# Read archive member names (one per line) on stdin; print, as absolute paths sorted and
# deduplicated, the extra/ files a restore would write that are flagged: those that run at boot or
# decide who may log in (is_startup_or_login), and every file outside /etc — those are binaries,
# libraries and plugin files, carried only by --include-plugins archives. Names go through
# normalize_member_paths first, so "etc//rc.local" or "./etc/./rc.local" cannot slip past. Both the
# prefixed (gl-portable-backup/extra/...) and the flat (extra/...) layout match. Entries restore
# never writes (extra_rel_skipped) are not listed.
startup_login_members() {
    local rel
    normalize_member_paths | while IFS= read -r rel; do
        rel="${rel#"${ARCHIVE_PREFIX}"/}"
        case "$rel" in extra/?*) rel="${rel#extra/}" ;; *) continue ;; esac
        case "$rel" in */) continue ;; esac
        extra_rel_skipped "$rel" && continue
        case "$rel" in
            etc/*) is_startup_or_login "$rel" || continue ;;
        esac
        printf '/%s\n' "$rel"
    done | sort -u
}

# ─── Manifest ──────────────────────────────────────────────────────────────────

write_manifest() {
    local outfile="$1"
    local mode="$2"
    local notes="$3"
    local sections="$4"
    local excluded="$5"
    local extra_files="$6"
    local suspect="${7:-}"

    # The two free-text fields are the only ones a user or a hostname can put a quote or a
    # backslash into; unescaped, either ends the JSON string and leaves a manifest jsonfilter
    # cannot read, which surfaces on restore as a bogus model mismatch against an empty value.
    notes=$(json_escape "$notes")
    local hostname
    hostname=$(json_escape "$(get_hostname)")

    cat > "$outfile" <<EOF
{
  "format_version": ${FORMAT_VERSION},
  "tool": "${TOOL_NAME}",
  "tool_version": "${VERSION}",
  "created_at": "$(get_timestamp)",
  "mode": "${mode}",
  "source": {
    "model": "$(get_model_name)",
    "model_id": "$(get_model_id)",
    "firmware_version": "$(get_fw_version)",
    "openwrt_version": "$(get_openwrt_version)",
    "architecture": "$(get_architecture)",
    "hostname": "${hostname}"
  },
  "sections": [${sections}],
  "excluded_sections": [${excluded}],
  "extra_files": [${extra_files}],
  "suspect_markers": [${suspect}],
  "notes": "${notes}"
}
EOF
}

# Build sections list from config directory contents
list_sections() {
    local confdir="$1"
    local result=""
    for f in "$confdir"/*; do
        [ -f "$f" ] || continue
        local name=$(basename "$f")
        if [ -n "$result" ]; then
            result="${result}, \"${name}\""
        else
            result="\"${name}\""
        fi
    done
    echo "$result"
}

# ─── CREATE ────────────────────────────────────────────────────────────────────

cmd_create() {
    local mode="clone"
    local output=""
    local notes=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --mode) mode="$2"; shift 2 ;;
            --output) output="$2"; shift 2 ;;
            --notes) notes="$2"; shift 2 ;;
            --include-plugins) GPB_INCLUDE_PLUGINS=1; shift ;;
            *) die "Unknown option: $1" ;;
        esac
    done

    case "$mode" in
        clone|remote-safe|profile|full) ;;
        *) die "Invalid mode: $mode (must be clone, remote-safe, profile, or full)" ;;
    esac

    # A newline would break the manifest's "notes" string across lines, and no escaping in
    # json_escape can express one, so it is refused here rather than written into an archive that
    # cannot be restored. wc -l counts the newlines in the value itself (printf adds none).
    [ "$(printf '%s' "$notes" | wc -l)" -eq 0 ] || die "--notes must be a single line (no newline)"

    local tmpdir=$(mktemp -d)
    trap "rm -rf '$tmpdir'" EXIT

    # All archive contents go under a prefix directory. This makes the archive
    # intentionally incompatible with stock LuCI backup restore (System > Flash),
    # which does "tar -C / -xzf" and expects paths like etc/config/*. Our prefix
    # causes extraction to /gl-portable-backup/* instead — harmless but clearly
    # wrong — preventing accidental router corruption from importing the wrong
    # archive type.
    local archdir="$tmpdir/${ARCHIVE_PREFIX}"
    mkdir -p "$archdir"

    local model_short=$(get_model_short)
    local hostname=$(get_hostname)
    local datestamp=$(get_datestamp)

    echo "Creating ${mode} backup..." >&2

    # Announced before capture and recorded in the manifest; the backup still runs. Nothing is
    # printed when no marker is found, because their absence is not evidence of a clean router.
    local markers suspect_json="" m
    markers=$(suspect_markers)
    if [ -n "$markers" ]; then
        echo "WARNING: this router has paths that the cleanup script in GL.iNet's KVM firmware removes after the 2026-11-20 incident. GL.iNet has published no such list for routers." >&2
        printf '%s\n' "$markers" | while IFS= read -r m; do echo "  $m" >&2; done
        echo "  A backup of a compromised router can carry the attacker's changes back. Prefer Profile mode. It stores no" >&2
        echo "  files, but it still carries settings an attacker may have changed (DNS mode and hosts entries, port" >&2
        echo "  forwards, WAN access, firewall rules, VPN client configurations): read those before restoring." >&2
        echo "  Treat every key and password in any backup of this router as exposed." >&2
        suspect_json=$(printf '%s\n' "$markers" | while IFS= read -r m; do
            printf '"%s", ' "$(json_escape "$m")"
        done | sed 's/, $//')
    fi

    # Hardware identity is recorded in every mode but Profile, which carries no device identity.
    if [ "$mode" = "profile" ]; then
        echo "  Profile mode: device identity (hardware IDs, serial) is not captured" >&2
    else
        capture_hardware_ids "$archdir/hardware.json"
        echo "  Captured hardware identity" >&2
    fi

    local sections=""
    local excluded=""

    if [ "$mode" = "profile" ]; then
        # Profile mode: API-only capture
        capture_profile "$archdir/api"
        sections=$(cd "$archdir/api" && for f in *.json; do [ -e "$f" ] || continue; printf '"%s", ' "${f%.json}"; done | sed 's/, $//')
        echo "  Captured API profile data" >&2
    else
        # Clone, Remote-Safe, Full: copy UCI config files
        mkdir -p "$archdir/config"
        cp -a "$ROOT"/etc/config/. "$archdir/config/"
        # opkg leaves *-opkg copies of conffiles it replaced: package-manager bookkeeping, not
        # user config. rm -f is a no-op when the glob matches nothing, so set -e is unaffected.
        rm -f "$archdir"/config/*-opkg
        # A name starting with a dot hides an entry from a plain ls, which is where a foothold on a
        # compromised router hides; no UCI config is ever named that way.
        local hidden_count
        hidden_count=$(strip_hidden_entries "$archdir/config")
        echo "  Skipped ${hidden_count} hidden entries under /etc/config" >&2
        echo "  Copied $(ls -A "$archdir/config/" | wc -l) UCI config files" >&2

        # Capture packages (enriched JSON + legacy text)
        capture_packages_json "$archdir/packages.json"
        capture_packages_txt "$archdir/packages.txt"
        local pkg_count
        pkg_count=$(count_packages_json "$archdir/packages.json")
        echo "  Captured ${pkg_count} user-installed packages" >&2

        # Capture non-UCI persistent files: keep.d, /etc/sysupgrade.conf, changed conffiles.
        # capture_extra_files prints three integers on one line. Splitting them with `set --` is
        # safe here: the option loop above consumed the arguments, so no positional parameter is
        # still needed. The command substitution keeps its own assignment line, because `set` is
        # a special builtin that returns 0 and would discard a failure inside the capture.
        local extra_counts extra_count skip_owned skip_rom skip_hidden
        extra_counts=$(capture_extra_files "$archdir" "$mode")
        set -- $extra_counts
        extra_count=$1; skip_owned=$2; skip_rom=$3; skip_hidden=$4
        echo "  Captured ${extra_count} extra persistent files" >&2
        echo "  Skipped ${skip_owned} firmware-owned, ${skip_rom} identical to /rom" >&2
        echo "  Skipped ${skip_hidden} hidden entries in the persistent-file list" >&2

        if [ "$mode" = "clone" ] || [ "$mode" = "remote-safe" ]; then
            # Strip hardware-specific fields
            sanitize_configs "$archdir/config"
            # /etc/config/gl_nas is a directory on 4.9+; ssl_webdav.pem in it is this unit's
            # WebDAV TLS private key — device-generated material, same treatment as the uhttpd
            # and nginx keys dropped from extra/ above.
            rm -f "$archdir/config/gl_nas/ssl_webdav.pem"
            echo "  Stripped hardware-specific fields" >&2
        fi

        if [ "$mode" = "remote-safe" ]; then
            # Build excluded sections list before removing files
            for f in $REMOTE_SAFE_EXCLUDE_FILES; do
                if [ -n "$excluded" ]; then
                    excluded="${excluded}, \"${f}\""
                else
                    excluded="\"${f}\""
                fi
            done

            # Remove remote-access config files
            exclude_remote_access_files "$archdir/config"
            echo "  Excluded remote-access config files" >&2

            # Filter network and firewall
            filter_network_remote_safe "$archdir/config/network"
            filter_firewall_remote_safe "$archdir/config/firewall"
            echo "  Filtered remote-access sections from network/firewall" >&2
        fi

        sections=$(list_sections "$archdir/config")
    fi

    # Build extra_files list for manifest
    local extra_files=""
    if [ -d "$archdir/extra" ]; then
        extra_files=$(cd "$archdir/extra" && find . -type f | sort | while IFS= read -r f; do
            f="${f#./}"
            printf '"/%s", ' "$f"
        done | sed 's/, $//')
    fi

    # Write manifest
    write_manifest "$archdir/manifest.json" "$mode" "$notes" "$sections" "$excluded" "$extra_files" "$suspect_json"

    # Write human-readable backup info and compatibility warning
    cat > "$archdir/backup-info.txt" <<INFOEOF
GL Portable Backup
==================
Mode:       ${mode}
Model:      $(get_model_name)
Model ID:   $(get_model_id)
Firmware:   $(get_fw_version)
Hostname:   $(get_hostname)
Created:    $(get_timestamp)
Tool:       ${TOOL_NAME} ${VERSION}

IMPORTANT: This archive was created by GL Portable Backup, a custom plugin
by RemoteToHome Consulting. It is NOT compatible with the standard LuCI
backup restore (System > Backup/Flash Firmware). Importing this file
through the stock LuCI restore interface will NOT work correctly.

To restore this backup, use:
  GL Admin Panel > Advanced > LuCI > System > GL Portable Backup

For support: https://remotetohome.io/contact
INFOEOF
    [ "$mode" != "profile" ] && printf "Skipped:    %s firmware-owned, %s identical to /rom\n" "${skip_owned}" "${skip_rom}" >> "$archdir/backup-info.txt"
    [ -n "$notes" ] && printf "Notes:      %s\n" "${notes}" >> "$archdir/backup-info.txt"

    # Create archive
    local fw_short=$(get_fw_version | tr '.' '-')
    output=$(resolve_output_path "$output" "gl-backup-${mode}-${hostname}-${model_short}-fw${fw_short}-${datestamp}.tar.gz")

    tar -czf "$output" -C "$tmpdir" "${ARCHIVE_PREFIX}"
    echo "  Archive: $output" >&2

    # Output the path (for LuCI to read)
    echo "$output"
}

# ─── INSPECT ───────────────────────────────────────────────────────────────────

# Members of a normalised listing relative to the archive root: the prefix directory stripped,
# so the prefixed and the flat layout read alike.
archive_rel_members() { sed "s|^${ARCHIVE_PREFIX}/||" "$1"; }

# True when any of the exact paths $2… is a member of the normalised listing in file $1.
listing_has() {
    local list="$1" pat
    shift
    for pat in "$@"; do
        if archive_rel_members "$list" | grep -q -x -F "$pat"; then return 0; fi
    done
    return 1
}

cmd_inspect() {
    local archive="$1"
    [ -z "$archive" ] && die "Usage: gl-portable-backup inspect ARCHIVE"
    [ -f "$archive" ] || die "File not found: $archive"

    local tmpdir=$(mktemp -d)
    trap "rm -rf '$tmpdir'" EXIT

    archive_precheck "$archive" "$tmpdir/listing"

    # Only the manifest is extracted. Try the prefixed layout first, fall back to flat.
    mkdir -p "$tmpdir/x"
    tar -xzf "$archive" -C "$tmpdir/x" "${ARCHIVE_PREFIX}/manifest.json" 2>/dev/null \
        || tar -xzf "$archive" -C "$tmpdir/x" manifest.json 2>/dev/null \
        || die "Invalid archive: no manifest.json"
    [ -L "$tmpdir/x/${ARCHIVE_PREFIX}" ] && die "Invalid archive: ${ARCHIVE_PREFIX} is a symbolic link"

    local manifest="$tmpdir/x/${ARCHIVE_PREFIX}/manifest.json"
    [ -e "$manifest" ] || [ -L "$manifest" ] || manifest="$tmpdir/x/manifest.json"
    [ -L "$manifest" ] && die "Invalid archive: manifest.json is a symbolic link"

    # The keys below are appended to the OUTPUT only — the archive's own manifest.json is never
    # rewritten. Built line-wise rather than with a sed replacement carrying a newline, which is not
    # portable: every line but the closing brace, a comma on the new last line, then the keys and the
    # brace. Any other layout could hide the appended keys from the reader, so it is refused.
    manifest_layout_ok "$manifest" || die "Invalid archive: manifest.json is not in the layout this tool writes"

    # What restoring this archive overwrites beyond configuration, from the normalised listing.
    local has_keys=false has_shadow=false
    if listing_has "$tmpdir/listing" "extra/etc/dropbear/dropbear_ed25519_host_key" \
            "extra/etc/dropbear/dropbear_rsa_host_key" \
            "extra/etc/dropbear/dropbear_ecdsa_host_key"; then
        has_keys=true
    fi
    if listing_has "$tmpdir/listing" "extra/etc/shadow"; then
        has_shadow=true
    fi
    # Files a restore writes that run at boot, control logins, or lie outside /etc, as a JSON array.
    # Every name is archive-controlled, so each goes through json_escape; an empty list is [].
    local startup_json
    startup_json=$(startup_login_members < "$tmpdir/listing" | while IFS= read -r f; do
        printf '"%s", ' "$(json_escape "$f")"
    done | sed 's/, $//')

    { sed '$d' "$manifest" | sed '$ s/$/,/'
      printf '  "restores_ssh_host_keys": %s,\n  "restores_root_password": %s,\n  "startup_and_login_files": [%s]\n}\n' \
          "$has_keys" "$has_shadow" "$startup_json"
    } > "$tmpdir/out"

    # The keys must read back at the top level exactly as computed; a manifest that nests them inside
    # an object of its own, or leaves the output unparseable, is refused rather than shown.
    # Both sides go through jsonfilter, so its own output format is never assumed.
    printf '{"k":%s,"p":%s,"v":[%s]}\n' "$has_keys" "$has_shadow" "$startup_json" > "$tmpdir/want"
    local key want got
    for key in restores_ssh_host_keys:k restores_root_password:p startup_and_login_files:v; do
        want=$(jsonfilter -i "$tmpdir/want" -e "@.${key#*:}" 2>/dev/null) || want="<unreadable>"
        got=$(jsonfilter -i "$tmpdir/out" -e "@.${key%%:*}" 2>/dev/null) || got="<absent>"
        [ "$got" = "$want" ] || die "Invalid archive: manifest.json is not in the layout this tool writes"
    done
    cat "$tmpdir/out"
}

# ─── FINGERPRINT ───────────────────────────────────────────────────────────────

# Print the SSH host-key fingerprint this archive would install, so the operator can recognise
# the key their SSH client warns about after a Full restore. No output, exit 0, when the archive
# carries no host keys.
cmd_fingerprint() {
    local archive="$1"
    [ -z "$archive" ] && die "Usage: gl-portable-backup fingerprint ARCHIVE"
    [ -f "$archive" ] || die "File not found: $archive"

    local tmpdir=$(mktemp -d)
    trap "rm -rf '$tmpdir'" EXIT

    archive_precheck "$archive" "$tmpdir/check"

    # Only the host keys are extracted, addressed by their exact names from the listing: no tar
    # wildcard support is required, and the prefixed and flat layouts both work.
    mkdir -p "$tmpdir/x"
    tar -tzf "$archive" > "$tmpdir/listing"
    local member
    while IFS= read -r member; do
        case "$member" in
            *extra/etc/dropbear/dropbear_*_host_key)
                tar -xzf "$archive" -C "$tmpdir/x" "$member" 2>/dev/null || true ;;
        esac
    done < "$tmpdir/listing"

    local base="$tmpdir/x"
    [ -d "$tmpdir/x/${ARCHIVE_PREFIX}" ] && base="$tmpdir/x/${ARCHIVE_PREFIX}"
    assert_extracted_tree_safe "$tmpdir/x" "$base"
    archive_hostkey_fingerprint "$base"
}

# ─── RESTORE ───────────────────────────────────────────────────────────────────

cmd_restore() {
    local archive=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --keep-host-keys) GPB_KEEP_HOST_KEYS=1 ;;
            -*) die "Unknown option: $1" ;;
            *) archive="$1" ;;
        esac
        shift
    done
    [ -z "$archive" ] && die "Usage: gl-portable-backup restore [--keep-host-keys] ARCHIVE"
    [ -f "$archive" ] || die "File not found: $archive"

    local tmpdir=$(mktemp -d)
    trap "rm -rf '$tmpdir'" EXIT

    # Nothing is extracted from an archive whose listing holds a hard link, a special file, a member
    # name that could escape or hide, or a symlink where the tool reads its own files.
    archive_precheck "$archive" "$tmpdir/listing"

    echo "Extracting backup..." >&2
    mkdir -p "$tmpdir/x"
    tar -xzf "$archive" -C "$tmpdir/x"

    # Resolve archive prefix (prefixed format or flat for backward compat)
    local x="$tmpdir/x"
    tmpdir="$x"
    if [ -d "$x/${ARCHIVE_PREFIX}" ]; then
        tmpdir="$x/${ARCHIVE_PREFIX}"
    fi
    assert_extracted_tree_safe "$x" "$tmpdir"

    [ -f "$tmpdir/manifest.json" ] || die "Invalid archive: no manifest.json"
    manifest_layout_ok "$tmpdir/manifest.json" || die "Invalid archive: manifest.json is not in the layout this tool writes"

    local mode=$(jsonfilter -i "$tmpdir/manifest.json" -e '@.mode')
    local backup_model=$(jsonfilter -i "$tmpdir/manifest.json" -e '@.source.model_id')
    local backup_fw=$(jsonfilter -i "$tmpdir/manifest.json" -e '@.source.firmware_version' 2>/dev/null)
    local current_model=$(get_model_id)
    local current_fw=$(get_fw_version)

    echo "Backup mode:     ${mode}" >&2
    echo "Backup model:    ${backup_model}" >&2
    echo "Backup firmware: ${backup_fw:-unknown}" >&2
    echo "This device:     ${current_model}" >&2
    echo "This firmware:   ${current_fw}" >&2

    # Model validation (hard block for non-profile modes)
    if [ "$mode" != "profile" ]; then
        if [ "$backup_model" != "$current_model" ]; then
            die "Model mismatch. Backup: ${backup_model}, This device: ${current_model}. Use 'profile' mode for cross-model restore."
        fi
    fi

    # Firmware version check (warning only — same model, different firmware)
    if [ -n "$backup_fw" ] && [ "$backup_fw" != "unknown" ] && [ "$backup_fw" != "$current_fw" ]; then
        echo "WARNING: Firmware version mismatch — backup: ${backup_fw}, this device: ${current_fw}" >&2
        echo "  UCI config schema may differ between firmware versions." >&2
        echo "  Clone/Remote-Safe restores are safest between identical firmware versions." >&2
        echo "  Consider using Profile mode for cross-version portability." >&2
    fi

    # A Full archive carries the source unit's own identity as well as its configuration. Both
    # overwrites are announced before anything is written; only the host keys can be opted out
    # of, because a restored /etc/shadow is how the admin password comes back after a reset.
    if archive_has_host_keys "$tmpdir"; then
        if [ "${GPB_KEEP_HOST_KEYS:-0}" = 1 ]; then
            echo "Keeping this device's SSH host keys (--keep-host-keys)" >&2
        else
            echo "WARNING: this archive restores the source's SSH host keys — SSH clients will see a changed key; expected: $(archive_hostkey_fingerprint "$tmpdir")" >&2
            echo "  Re-run with --keep-host-keys to keep this device's own SSH identity." >&2
        fi
    fi
    if [ -f "$tmpdir/extra/etc/shadow" ]; then
        echo "WARNING: this archive restores /etc/shadow — the root (admin) password becomes the source unit's password" >&2
    fi
    # Files that run at boot or control logins are where an attacker's changes persist; a restore
    # of an archive from a router that may have been compromised brings them back with root's
    # rights, so they are named before anything is written. Neither warning blocks the restore.
    local startup
    startup=$(if [ -d "$tmpdir/extra" ]; then (cd "$tmpdir" && find extra ! -type d); fi | startup_login_members)
    if [ -n "$startup" ]; then
        echo "WARNING: this archive restores files that run at startup or control logins, or that lie outside /etc:" >&2
        printf '%s\n' "$startup" | while IFS= read -r f; do echo "  $f" >&2; done
        echo "  If the source router may have been compromised, inspect these before rebooting." >&2
    fi
    local markers="" marker idx=0
    while [ "$idx" -lt 64 ]; do
        marker=$(jsonfilter -i "$tmpdir/manifest.json" -e "@.suspect_markers[$idx]" 2>/dev/null) || marker=""
        [ -n "$marker" ] || break
        # Archive-controlled text reaching the terminal: only a plain absolute path is printed, so a
        # newline or an escape sequence in the value cannot forge a line of this tool's output.
        case "$marker" in
            /*) case "$marker" in *[!A-Za-z0-9._/-]*) marker="<unprintable entry>" ;; esac ;;
            *) marker="<unprintable entry>" ;;
        esac
        markers="${markers:+$markers, }$marker"
        idx=$((idx + 1))
    done
    if [ -n "$markers" ]; then
        echo "WARNING: this archive was made on a router that had paths the cleanup script in GL.iNet's KVM firmware removes after the 2026-11-20 incident: $markers" >&2
    fi

    case "$mode" in
        clone|remote-safe)
            restore_portable "$tmpdir" "$mode"
            ;;
        profile)
            restore_profile "$tmpdir"
            ;;
        full)
            restore_full "$tmpdir"
            ;;
        *)
            die "Unknown backup mode: $mode"
            ;;
    esac

    echo "Restore complete. Reboot recommended." >&2
    echo "RESTORE_OK"
}

# Restore an archive's config/ tree onto /etc/config. The archive is attacker-influenced input, so
# the tree is staged first and only directories and regular files with visible names go across:
# no hidden entry (at any depth, even from an archive built by an older version or by hand) and no
# symlink, which could point anywhere outside the tree. Prints the number of regular files restored.
# With a second argument, writes "<hidden dropped> <non-regular dropped>" to that file.
restore_config_tree() {
    local src="$1" countfile="${2:-}"
    if [ ! -d "$src" ]; then
        [ -n "$countfile" ] && echo "0 0" > "$countfile"
        echo 0
        return 0
    fi
    local stage hidden other
    stage=$(mktemp -d) || return 1
    cp -a "$src"/. "$stage/" || { rm -rf "$stage"; return 1; }
    hidden=$(strip_hidden_entries "$stage")
    other=$(find "$stage" ! -type f ! -type d -exec rm -f {} \; -exec printf x \; | wc -c)
    [ -n "$countfile" ] && echo "$((hidden)) $((other))" > "$countfile"
    mkdir -p "$ROOT/etc/config" || { rm -rf "$stage"; return 1; }
    # A failing cp must stop the restore: under BusyBox ash errexit does not reach into the command
    # substitution the caller runs this in, so the status is returned explicitly.
    cp -a "$stage"/. "$ROOT/etc/config/" || { rm -rf "$stage"; return 1; }
    find "$stage" -type f | wc -l
    rm -rf "$stage"
}

# restore_config_tree plus what the operator is told: the restored count, and one warning line for
# each kind of entry the archive held that was not restored.
apply_config_tree() {
    local src="$1" countfile restored hidden other
    countfile=$(mktemp) || die "cannot create a temporary file"
    restored=$(restore_config_tree "$src" "$countfile") || { rm -f "$countfile"; die "config restore failed — see the line above"; }
    read -r hidden other < "$countfile" || true
    rm -f "$countfile"
    echo "  Restored ${restored} config entries" >&2
    if [ "${hidden:-0}" -gt 0 ]; then
        echo "  WARNING: ${hidden} hidden entries under config/ in this archive were NOT restored" >&2
    fi
    if [ "${other:-0}" -gt 0 ]; then
        echo "  WARNING: ${other} symbolic links or other non-regular entries under config/ in this archive were NOT restored" >&2
    fi
}

restore_portable() {
    local tmpdir="$1"
    local mode="$2"
    local saved_hw=$(mktemp -d)

    echo "Saving current hardware identity..." >&2

    # Save current device's hardware-specific values before overwriting
    # Network MACs
    grep 'option macaddr' "$ROOT/etc/config/network" > "$saved_hw/network_macs" 2>/dev/null || true
    grep 'option macaddr' "$ROOT/etc/config/wireless" > "$saved_hw/wireless_macs" 2>/dev/null || true

    # Remote-safe: also save excluded configs
    if [ "$mode" = "remote-safe" ]; then
        for f in $REMOTE_SAFE_EXCLUDE_FILES; do
            [ -f "$ROOT/etc/config/$f" ] && cp -a "$ROOT/etc/config/$f" "$saved_hw/$f"
        done
        # LIMITATION (1.1): only whole excluded FILES are preserved. The target's own
        # zerotier*/tailscale* sections inside network and firewall — the interface, its zone and
        # its forwardings — are not extracted here, so restore_config_tree below overwrites them
        # with the archive's filtered copies, which have none. The tunnel's daemon keeps running
        # and its own config file is preserved, but LAN forwarding and masquerade for it are gone
        # until the service is re-enabled. The notice below says so; implementing the preservation
        # is the fix.
    fi

    echo "Applying backup configs..." >&2
    if [ "$mode" = "remote-safe" ]; then
        echo "NOTE: this release restores the archive's network/firewall files as filtered; the target's ZeroTier/Tailscale interface, zone and forwarding sections are NOT re-added — re-enable those services after the restore" >&2
    fi

    # Apply config files from archive
    apply_config_tree "$tmpdir/config"

    # Restore non-UCI persistent files (keep.d)
    if [ -d "$tmpdir/extra" ]; then
        local extra_restored
        extra_restored=$(restore_extra_files "$tmpdir") || die "extra file restore failed — see the line above"
        echo "  Restored ${extra_restored} extra persistent files" >&2
    fi

    echo "Re-injecting hardware identity..." >&2

    # Re-inject this device's MAC addresses into network config
    # Read MACs from board.json (the authoritative source)
    local lan_mac=$(jsonfilter -i "$ROOT/etc/board.json" -e '@.network.lan.macaddr' 2>/dev/null)
    local wan_mac=$(jsonfilter -i "$ROOT/etc/board.json" -e '@.network.wan.macaddr' 2>/dev/null)

    if [ -n "$lan_mac" ]; then
        # Find br-lan device section and add macaddr
        # Use UCI to set it properly
        local br_dev=$(uci -q get network.@device[0].name 2>/dev/null)
        if [ "$br_dev" = "br-lan" ]; then
            uci -q set network.@device[0].macaddr="$lan_mac"
        fi
        # Also set eth1 device if it exists
        local i=0
        while uci -q get network.@device[$i].name >/dev/null 2>&1; do
            local dev_name=$(uci -q get network.@device[$i].name)
            case "$dev_name" in
                br-lan|eth1)
                    uci -q set network.@device[$i].macaddr="$lan_mac"
                    ;;
                eth0)
                    [ -n "$wan_mac" ] && uci -q set network.@device[$i].macaddr="$wan_mac"
                    ;;
            esac
            i=$((i + 1))
        done
        uci commit network
    fi

    # Re-inject Wi-Fi MACs from saved state
    # The wireless config from the backup has no MACs (stripped).
    # We need the current device's Wi-Fi MACs.
    # On GL.iNet routers, Wi-Fi MACs are randomized per-interface — we restore
    # what was saved from this device before the overwrite.
    if [ -s "$saved_hw/wireless_macs" ]; then
        # Re-apply saved MAC addresses to the matching interface positions
        local idx=0
        while IFS= read -r line; do
            local mac=$(echo "$line" | awk '{print $3}' | tr -d "'")
            uci -q set wireless.@wifi-iface[$idx].macaddr="$mac" 2>/dev/null || true
            idx=$((idx + 1))
        done < "$saved_hw/wireless_macs"
        uci commit wireless
    fi

    reinitialize_ddns "$tmpdir"

    # Remote-safe: restore the excluded config files from saved state
    if [ "$mode" = "remote-safe" ]; then
        echo "Restoring preserved remote-access configs..." >&2
        for f in $REMOTE_SAFE_EXCLUDE_FILES; do
            [ -f "$saved_hw/$f" ] && cp -a "$saved_hw/$f" "$ROOT/etc/config/$f"
        done
    fi

    rm -rf "$saved_hw"
    echo "Hardware identity preserved." >&2
}

# Profile archives before format 4 named each file after the setting (led.json); format 4 names
# it after the API call that produced it (led.get_config.json), and 4.11 archives carry
# vlan_subnet.* where older ones carry lan.*. Restore accepts every generation: print the first
# candidate name that exists, and nothing when none of them do.
api_file() {   # apidir name...
    local dir="$1" name
    shift
    for name in "$@"; do
        if [ -f "$dir/$name" ]; then echo "$dir/$name"; return 0; fi
    done
    return 0
}

restore_profile() {
    local tmpdir="$1"
    local apidir="$tmpdir/api"
    local sid

    [ -d "$apidir" ] || die "Invalid profile backup: no api/ directory"

    echo "Authenticating to local API..." >&2
    sid=$(gl_auth) || die "Failed to authenticate to local API — see the line above"

    # Restore timezone
    local tz_file
    tz_file=$(api_file "$apidir" system.get_timezone_config.json timezone.json)
    if [ -n "$tz_file" ]; then
        local tz_result=$(jsonfilter -i "$tz_file" -e '@.result')
        if [ -n "$tz_result" ] && [ "$tz_result" != "null" ]; then
            local zonename=$(jsonfilter -i "$tz_file" -e '@.result.zonename' 2>/dev/null)
            if [ -n "$zonename" ]; then
                gl_api "$sid" "system" "set_timezone_config" "{\"zonename\":\"$zonename\"}" >/dev/null 2>&1 || echo "  WARNING: system.set_timezone_config failed" >&2
                echo "  Restored timezone: $zonename" >&2
            fi
        fi
    fi

    # Restore DNS config
    local dns_file
    dns_file=$(api_file "$apidir" dns.get_config.json dns_config.json)
    if [ -n "$dns_file" ]; then
        local dns_result=$(jsonfilter -i "$dns_file" -e '@.result')
        if [ -n "$dns_result" ] && [ "$dns_result" != "null" ]; then
            local dns_mode=$(jsonfilter -i "$dns_file" -e '@.result.mode' 2>/dev/null || echo "")
            local force_dns=$(jsonfilter -i "$dns_file" -e '@.result.force_dns' 2>/dev/null || echo "")
            if [ -n "$dns_mode" ]; then
                local params="{\"mode\":\"$dns_mode\""
                [ -n "$force_dns" ] && params="${params},\"force_dns\":$force_dns"
                params="${params}}"
                gl_api "$sid" "dns" "set_config" "$params" >/dev/null 2>&1 || echo "  WARNING: dns.set_config failed" >&2
                echo "  Restored DNS config" >&2
            fi
        fi
    fi

    # Restore DNS hosts
    local hosts_file
    hosts_file=$(api_file "$apidir" dns.get_host.json dns_hosts.json)
    if [ -n "$hosts_file" ]; then
        local hosts_content=$(jsonfilter -i "$hosts_file" -e '@.result.content' 2>/dev/null)
        if [ -n "$hosts_content" ]; then
            local escaped=$(echo "$hosts_content" | sed 's/"/\\"/g')
            gl_api "$sid" "dns" "set_host" "{\"content\":\"$escaped\"}" >/dev/null 2>&1 || echo "  WARNING: dns.set_host failed" >&2
            echo "  Restored DNS hosts" >&2
        fi
    fi

    # Restore LED config
    local led_file
    led_file=$(api_file "$apidir" led.get_config.json led.json)
    if [ -n "$led_file" ]; then
        local led_enable=$(jsonfilter -i "$led_file" -e '@.result.led_enable' 2>/dev/null)
        if [ -n "$led_enable" ]; then
            gl_api "$sid" "led" "set_config" "{\"led_enable\":$led_enable}" >/dev/null 2>&1 || echo "  WARNING: led.set_config failed" >&2
            echo "  Restored LED config" >&2
        fi
    fi

    # Restore Wi-Fi config (map by band)
    local wifi_file
    wifi_file=$(api_file "$apidir" wifi.get_config.json wifi.json)
    if [ -n "$wifi_file" ]; then
        echo "  Restoring Wi-Fi (mapped by band)..." >&2
        restore_profile_wifi "$sid" "$wifi_file"
    fi

    # Restore LAN config (vlan_subnet on 4.11+, lan before it)
    local lan_file
    lan_file=$(api_file "$apidir" vlan_subnet.get_subnets.json lan.get_config_list.json lan.json)
    if [ -n "$lan_file" ]; then
        echo "  Restoring LAN config..." >&2
        restore_profile_lan "$sid" "$lan_file"
    fi

    # Restore DHCP static bindings (fixed IP assignments)
    local binds_file
    binds_file=$(api_file "$apidir" vlan_subnet.get_static_bind_list.json lan.get_static_bind_list.json dhcp_static_binds.json)
    if [ -n "$binds_file" ]; then
        restore_profile_dhcp_static "$sid" "$binds_file"
    fi

    echo "  Profile restore complete" >&2
}

restore_profile_wifi() {
    local sid="$1"
    local wifi_file="$2"

    # Get current Wi-Fi config from target to map interfaces by band
    local current_wifi=$(gl_api "$sid" "wifi" "get_config" '{}')

    # For each interface in the backup, find matching interface on target by band+guest
    # This is simplified — full implementation will parse JSON arrays properly
    # For now, just set SSID/key on all interfaces
    echo "    Wi-Fi profile restore requires JSON array parsing — placeholder" >&2
}

restore_profile_lan() {
    local sid="$1"
    local lan_file="$2"

    # Simplified — set LAN IP from backup
    echo "    LAN profile restore requires JSON parsing — placeholder" >&2
}

restore_profile_dhcp_static() {
    local sid="$1"
    local binds_file="$2"

    # Every call below goes through the `lan` module, which 4.11 replaced with `vlan_subnet`.
    # Its binding methods are not spoken yet, so report what was skipped rather than fire calls
    # the router answers with "method not found" while nothing here notices.
    if ! api_module_present lan; then
        echo "  Static bindings: skipped — this firmware has no lan API (use a Clone archive or wait for Profile restore v2)" >&2
        return 0
    fi

    # Check if backup has any static bindings
    # grep -c prints 0 and exits 1 when nothing matches, so the count is taken from its output and
    # its status is tolerated separately. Folding both into `$(… || echo 0)` makes the no-match case
    # print two lines, which every later test on $count then has to survive by accident.
    local count
    count=$(jsonfilter -i "$binds_file" -e '@.result.static_bind_list[*]' 2>/dev/null | grep -c '"mac"') || true
    count="${count:-0}"
    if [ "$count" = "0" ]; then
        echo "  No DHCP static bindings in backup" >&2
        return 0
    fi

    echo "  Restoring $count DHCP static binding(s)..." >&2

    # Get current bindings on target to avoid duplicates
    local current
    current=$(gl_api "$sid" "lan" "get_static_bind_list" '{}')

    # For each binding in the backup, add or update on target
    local idx=0
    while true; do
        local mac ip name
        mac=$(jsonfilter -i "$binds_file" -e "@.result.static_bind_list[$idx].mac" 2>/dev/null)
        [ -z "$mac" ] && break

        ip=$(jsonfilter -i "$binds_file" -e "@.result.static_bind_list[$idx].ip" 2>/dev/null)
        name=$(jsonfilter -i "$binds_file" -e "@.result.static_bind_list[$idx].name" 2>/dev/null)

        if [ -n "$mac" ] && [ -n "$ip" ]; then
            local params="{\"mac\":\"$mac\",\"ip\":\"$ip\""
            [ -n "$name" ] && params="${params},\"name\":\"$name\""
            params="${params}}"

            # Check if this MAC already exists on target
            local existing
            existing=$(echo "$current" | jsonfilter -e '@.result.static_bind_list[*].mac' 2>/dev/null | grep -c "$mac") || true
            existing="${existing:-0}"

            if [ "$existing" -gt 0 ]; then
                # Update existing binding
                gl_api "$sid" "lan" "set_static_bind" "$params" >/dev/null 2>&1 || echo "  WARNING: lan.set_static_bind failed" >&2
                echo "    Updated: $mac -> $ip ($name)" >&2
            else
                # Add new binding
                gl_api "$sid" "lan" "add_static_bind" "$params" >/dev/null 2>&1 || echo "  WARNING: lan.add_static_bind failed" >&2
                echo "    Added: $mac -> $ip ($name)" >&2
            fi
        fi

        idx=$((idx + 1))
    done
}

restore_full() {
    local tmpdir="$1"

    echo "Applying full backup (hardware IDs will be overwritten)..." >&2

    apply_config_tree "$tmpdir/config"

    # Restore non-UCI persistent files (keep.d)
    if [ -d "$tmpdir/extra" ]; then
        local extra_restored
        extra_restored=$(restore_extra_files "$tmpdir") || die "extra file restore failed — see the line above"
        echo "  Restored ${extra_restored} extra persistent files" >&2
    fi

    # Re-initialize DDNS service (required after factory reset + restore)
    reinitialize_ddns "$tmpdir"

    echo "Full restore applied." >&2
}

# ─── PACKAGES (Compare archive packages vs target device) ───────────────────

cmd_packages() {
    local archive="$1"
    [ -z "$archive" ] && die "Usage: gl-portable-backup packages ARCHIVE"
    [ -f "$archive" ] || die "File not found: $archive"

    local tmpdir=$(mktemp -d)
    trap "rm -rf '$tmpdir'" EXIT

    archive_precheck "$archive" "$tmpdir/check"
    local f

    # Extract package data from archive (try prefixed, then flat for backward compat)
    local has_json=0 has_txt=0
    tar -xzf "$archive" -C "$tmpdir" "${ARCHIVE_PREFIX}/packages.json" 2>/dev/null && has_json=1
    [ "$has_json" = "0" ] && tar -xzf "$archive" -C "$tmpdir" packages.json 2>/dev/null && has_json=1
    tar -xzf "$archive" -C "$tmpdir" "${ARCHIVE_PREFIX}/packages.txt" 2>/dev/null && has_txt=1
    [ "$has_txt" = "0" ] && tar -xzf "$archive" -C "$tmpdir" packages.txt 2>/dev/null && has_txt=1
    [ -L "$tmpdir/${ARCHIVE_PREFIX}" ] && die "Invalid archive: ${ARCHIVE_PREFIX} is a symbolic link"
    for f in "$tmpdir/${ARCHIVE_PREFIX}/packages.json" "$tmpdir/${ARCHIVE_PREFIX}/packages.txt" \
             "$tmpdir/packages.json" "$tmpdir/packages.txt"; do
        [ -L "$f" ] && die "Invalid archive: $(basename "$f") is a symbolic link"
    done

    [ "$has_json" = "0" ] && [ "$has_txt" = "0" ] && \
        die "Archive contains no package information"

    # Resolve prefix — move files to tmpdir root for uniform access
    if [ -d "$tmpdir/${ARCHIVE_PREFIX}" ]; then
        [ -f "$tmpdir/${ARCHIVE_PREFIX}/packages.json" ] && mv "$tmpdir/${ARCHIVE_PREFIX}/packages.json" "$tmpdir/"
        [ -f "$tmpdir/${ARCHIVE_PREFIX}/packages.txt" ] && mv "$tmpdir/${ARCHIVE_PREFIX}/packages.txt" "$tmpdir/"
    fi

    # Get target device installed packages (all installed, not just user-installed)
    awk '/^Package:/{pkg=$2} /^Version:/{ver=$2} /^Status:.*installed/{print pkg "\t" ver}' \
        "$ROOT/usr/lib/opkg/status" > "$tmpdir/installed.tsv" 2>/dev/null

    # Get available packages from opkg feeds (best-effort)
    local feeds_ok=0
    opkg list 2>/dev/null | awk '{print $1 "\t" $3}' > "$tmpdir/available.tsv" 2>/dev/null
    [ -s "$tmpdir/available.tsv" ] && feeds_ok=1

    # Sentinel markers for awk multi-file parsing (POSIX-compatible alternative to process substitution)
    echo "---END_INSTALLED---" > "$tmpdir/end_installed.marker"
    echo "---END_AVAILABLE---" > "$tmpdir/end_available.marker"

    # Get target kernel version
    local target_kver
    target_kver=$(get_kernel_version)

    if [ "$has_json" = "1" ]; then
        _packages_compare_json "$tmpdir" "$target_kver" "$feeds_ok"
    else
        _packages_compare_txt "$tmpdir" "$target_kver" "$feeds_ok"
    fi
}

_packages_compare_json() {
    local tmpdir="$1" target_kver="$2" feeds_ok="$3"

    # Single-pass awk: read installed + available lists, then compare against packages.json
    awk -v target_kver="$target_kver" -v feeds_ok="$feeds_ok" '
    BEGIN {
        # Phase: 1=installed, 2=available, 3=packages.json
        phase = 1
        first_i = 1; first_mk = 1; first_ma = 1; first_mu = 1
    }

    # Phase 1: installed packages (tab-separated name\tversion)
    phase == 1 && /^$/ { next }
    phase == 1 && $0 == "---END_INSTALLED---" { phase = 2; next }
    phase == 1 {
        split($0, f, "\t")
        inst_ver[f[1]] = f[2]
        inst[f[1]] = 1
        next
    }

    # Phase 2: available packages (tab-separated name\tversion)
    phase == 2 && /^$/ { next }
    phase == 2 && $0 == "---END_AVAILABLE---" { phase = 3; next }
    phase == 2 {
        split($0, f, "\t")
        avail_ver[f[1]] = f[2]
        avail[f[1]] = 1
        next
    }

    # Phase 3: packages.json — extract source_kernel then each package
    phase == 3 && /\"kernel_version\"/ {
        match($0, /"kernel_version": *"([^"]*)"/, m)
        source_kver = m[1]
        next
    }

    phase == 3 && /\"name\"/ {
        match($0, /"name": *"([^"]*)"/, m); pkg_name = m[1]
    }
    phase == 3 && /\"version\"/ && !/kernel_version/ {
        match($0, /"version": *"([^"]*)"/, m); pkg_ver = m[1]
    }
    phase == 3 && /\"section\"/ {
        match($0, /"section": *"([^"]*)"/, m); pkg_sec = m[1]
    }
    phase == 3 && /\"description\"/ {
        match($0, /"description": *"([^"]*)"/, m); pkg_desc = m[1]
    }
    phase == 3 && /\"is_kmod\"/ {
        match($0, /"is_kmod": *(true|false)/, m); pkg_is_kmod = m[1]
    }

    # End of a package object — closing brace with possible comma
    phase == 3 && /^    \}/ {
        if (pkg_name == "") next

        if (inst[pkg_name]) {
            tver = inst_ver[pkg_name]
            vmatch = (pkg_ver == tver) ? "true" : "false"
            if (!first_i) i_buf = i_buf ",\n"
            first_i = 0
            i_buf = i_buf sprintf("    {\"name\":\"%s\",\"source_version\":\"%s\",\"target_version\":\"%s\",\"version_match\":%s,\"is_kmod\":%s,\"description\":\"%s\"}", \
                pkg_name, pkg_ver, tver, vmatch, pkg_is_kmod, pkg_desc)
        } else if (pkg_is_kmod == "true") {
            if (!first_mk) mk_buf = mk_buf ",\n"
            first_mk = 0
            mk_buf = mk_buf sprintf("    {\"name\":\"%s\",\"version\":\"%s\",\"section\":\"%s\",\"description\":\"%s\"}", \
                pkg_name, pkg_ver, pkg_sec, pkg_desc)
        } else if (feeds_ok == "1" && avail[pkg_name]) {
            aver = avail_ver[pkg_name]
            if (!first_ma) ma_buf = ma_buf ",\n"
            first_ma = 0
            ma_buf = ma_buf sprintf("    {\"name\":\"%s\",\"source_version\":\"%s\",\"available_version\":\"%s\",\"description\":\"%s\"}", \
                pkg_name, pkg_ver, aver, pkg_desc)
        } else {
            if (!first_mu) mu_buf = mu_buf ",\n"
            first_mu = 0
            mu_buf = mu_buf sprintf("    {\"name\":\"%s\",\"version\":\"%s\",\"section\":\"%s\",\"description\":\"%s\"}", \
                pkg_name, pkg_ver, pkg_sec, pkg_desc)
        }

        pkg_name = ""; pkg_ver = ""; pkg_sec = ""; pkg_desc = ""; pkg_is_kmod = ""
        next
    }

    END {
        kernel_match = (source_kver == target_kver) ? "true" : "false"
        feeds_avail = (feeds_ok == "1") ? "true" : "false"

        printf "{\n"
        printf "  \"source_kernel\": \"%s\",\n", source_kver
        printf "  \"target_kernel\": \"%s\",\n", target_kver
        printf "  \"kernel_match\": %s,\n", kernel_match
        printf "  \"feeds_available\": %s,\n", feeds_avail
        printf "  \"installed\": [\n%s\n  ],\n", i_buf
        printf "  \"missing_kmod\": [\n%s\n  ],\n", mk_buf
        printf "  \"missing_available\": [\n%s\n  ],\n", ma_buf
        printf "  \"missing_unavailable\": [\n%s\n  ]\n", mu_buf
        printf "}\n"
    }
    ' "$tmpdir/installed.tsv" "$tmpdir/end_installed.marker" \
      "$tmpdir/available.tsv" "$tmpdir/end_available.marker" \
      "$tmpdir/packages.json"
}

_packages_compare_txt() {
    local tmpdir="$1" target_kver="$2" feeds_ok="$3"

    # Legacy mode: name-only, no kmod detection, no version comparison
    awk -v target_kver="$target_kver" -v feeds_ok="$feeds_ok" '
    BEGIN {
        phase = 1
        first_i = 1; first_ma = 1; first_mu = 1
    }

    phase == 1 && /^$/ { next }
    phase == 1 && $0 == "---END_INSTALLED---" { phase = 2; next }
    phase == 1 {
        split($0, f, "\t")
        inst[f[1]] = 1
        next
    }

    phase == 2 && /^$/ { next }
    phase == 2 && $0 == "---END_AVAILABLE---" { phase = 3; next }
    phase == 2 {
        split($0, f, "\t")
        avail[f[1]] = 1
        next
    }

    # Phase 3: packages.txt — one name per line
    phase == 3 && /^$/ { next }
    phase == 3 {
        name = $1
        if (inst[name]) {
            if (!first_i) i_buf = i_buf ",\n"
            first_i = 0
            i_buf = i_buf sprintf("    {\"name\":\"%s\"}", name)
        } else if (feeds_ok == "1" && avail[name]) {
            if (!first_ma) ma_buf = ma_buf ",\n"
            first_ma = 0
            ma_buf = ma_buf sprintf("    {\"name\":\"%s\"}", name)
        } else {
            if (!first_mu) mu_buf = mu_buf ",\n"
            first_mu = 0
            mu_buf = mu_buf sprintf("    {\"name\":\"%s\"}", name)
        }
    }

    END {
        printf "{\n"
        printf "  \"source_kernel\": \"unknown\",\n"
        printf "  \"target_kernel\": \"%s\",\n", target_kver
        printf "  \"kernel_match\": false,\n"
        printf "  \"feeds_available\": %s,\n", (feeds_ok == "1" ? "true" : "false")
        printf "  \"installed\": [\n%s\n  ],\n", i_buf
        printf "  \"missing_kmod\": [],\n"
        printf "  \"missing_available\": [\n%s\n  ],\n", ma_buf
        printf "  \"missing_unavailable\": [\n%s\n  ]\n", mu_buf
        printf "}\n"
    }
    ' "$tmpdir/installed.tsv" "$tmpdir/end_installed.marker" \
      "$tmpdir/available.tsv" "$tmpdir/end_available.marker" \
      "$tmpdir/packages.txt"
}

# ─── INSTALL-PACKAGE ────────────────────────────────────────────────────────────

cmd_install_package() {
    local pkg="$1"
    [ -z "$pkg" ] && die "Usage: gl-portable-backup install-package PKG"

    local stdout stderr code

    stderr=$(opkg install "$pkg" 2>&1 >/tmp/gl-pb-opkg.tmp)
    code=$?
    stdout=$(cat /tmp/gl-pb-opkg.tmp 2>/dev/null || echo "")
    rm -f /tmp/gl-pb-opkg.tmp

    # Escape for JSON
    stdout=$(printf '%s' "$stdout" | sed 's/"/\\"/g' | tr '\n' ' ')
    stderr=$(printf '%s' "$stderr" | sed 's/"/\\"/g' | tr '\n' ' ')

    printf '{"name":"%s","code":%d,"stdout":"%s","stderr":"%s"}\n' \
        "$pkg" "$code" "$stdout" "$stderr"
}

# ─── Plugin self-update ───────────────────────────────────────────────────────
# Manual, checksum-verified update from the project's GitHub releases. Only plain versions are offered: a
# tag with a suffix (-beta.1, -rc1) is a prerelease, which releases/latest never returns anyway. The
# worker runs from a copy of this script under /tmp, because opkg replaces this file mid-install.

UPD_REPO="RemoteToHome-io/gl-portable-backup"
UPD_API_URL="${GPB_UPDATE_API_URL:-https://api.github.com/repos/$UPD_REPO/releases/latest}"
UPD_BASE_URL="${GPB_UPDATE_BASE_URL:-https://github.com/$UPD_REPO/releases/download}"
# Two fixed state paths — the status file update-status reads and the lock update-start probes. Both are
# refused when anything but a regular file sits there, and the status file is replaced atomically, so a
# path planted under /tmp by a local process is never followed by root.
UPD_STATE="${GPB_UPDATE_STATE:-/tmp/gl-portable-backup-update}"
UPD_STATUS="$UPD_STATE.status"
UPD_LOCK="$UPD_STATE.lock"
# The per-run working directory (staged worker copy, downloads, logs) is a fresh mktemp directory that
# update-start hands to the worker; update-install creates its own when run directly.
UPD_DIR="${GPB_UPDATE_DIR:-}"
UPD_PKG="luci-app-gl-portable-backup"
UPD_LATEST=""
UPD_RELEASE_URL=""
UPD_STEP=""

ver_base() { printf '%s' "$1" | sed 's/-.*//'; }

# ver_gt A B: A is newer than B. Numeric dotted compare of the bases; with equal bases a version carrying
# a suffix (1.0.0-beta.2) ranks below the plain one (1.0.0), and two suffixed versions are never ordered.
ver_gt() {
    local a b i x y
    a=$(ver_base "$1"); b=$(ver_base "$2")
    i=1
    while [ $i -le 4 ]; do
        x=$(printf '%s' "$a" | cut -d. -f$i | tr -dc '0-9'); y=$(printf '%s' "$b" | cut -d. -f$i | tr -dc '0-9')
        x=${x:-0}; y=${y:-0}
        [ "$x" -gt "$y" ] && return 0
        [ "$x" -lt "$y" ] && return 1
        i=$((i+1))
    done
    case "$1" in *-*) return 1 ;; esac
    case "$2" in *-*) return 0 ;; esac
    return 1
}

# Prints the installed package version from opkg; nothing when the plugin is not installed through opkg
# (a copy run from /tmp, as the smoke test does).
upd_installed_version() {
    opkg status "$UPD_PKG" 2>/dev/null | sed -n 's/^Version: //p' | head -n 1
}

# Queries the release API. Sets UPD_LATEST (plain version, "" when no stable release exists or the tag is
# unusable) and UPD_RELEASE_URL (kept only for the project's own GitHub pages). Returns 0 in those cases
# and 1 — with one line on stderr — when the server could not be reached or answered with an error.
upd_query_latest() {
    local body code rc tag
    UPD_LATEST=""; UPD_RELEASE_URL=""
    body=$(mktemp) || { echo "update: cannot create a temporary file" >&2; return 1; }
    rc=0; code=$(curl -fsS --connect-timeout 15 --max-time 60 -o "$body" -w '%{http_code}' "$UPD_API_URL") || rc=$?
    if [ "$rc" -ne 0 ]; then
        rm -f "$body"
        case "$code" in
            404) return 0 ;;
            ""|000) echo "update: cannot reach the release server (curl exit $rc)" >&2; return 1 ;;
            *) echo "update: the release server answered HTTP $code (curl exit $rc)" >&2; return 1 ;;
        esac
    fi
    tag=$(jsonfilter -i "$body" -e '@.tag_name' 2>/dev/null) || tag=""
    UPD_RELEASE_URL=$(jsonfilter -i "$body" -e '@.html_url' 2>/dev/null) || UPD_RELEASE_URL=""
    rm -f "$body"
    [ -n "$tag" ] || { echo "update: the release reply carries no tag_name" >&2; return 1; }
    UPD_LATEST="${tag#v}"
    # Never a prerelease, never anything that is not digits and dots (the value ends up in a URL path).
    case "$UPD_LATEST" in *-*|''|*[!0-9.]*) UPD_LATEST=""; UPD_RELEASE_URL=""; return 0 ;; esac
    case "$UPD_RELEASE_URL" in "https://github.com/$UPD_REPO/"*) ;; *) UPD_RELEASE_URL="" ;; esac
    return 0
}

cmd_update_check() {
    local installed via_opkg avail msg errfile
    installed=$(upd_installed_version) || installed=""
    if [ -n "$installed" ]; then via_opkg=true; else via_opkg=false; installed="$VERSION"; fi
    avail=false; msg=""
    errfile=$(mktemp) || errfile=/dev/null
    if upd_query_latest 2>"$errfile"; then
        if [ -z "$UPD_LATEST" ]; then
            msg="No stable release is published yet"
        elif [ "$via_opkg" = true ] && ver_gt "$UPD_LATEST" "$installed"; then
            avail=true
        fi
    else
        msg=$(head -n 1 "$errfile" | sed 's/^update: //')
    fi
    [ "$errfile" = /dev/null ] || rm -f "$errfile"
    printf '{"installed":"%s","installed_via_opkg":%s,"latest":"%s","update_available":%s,"release_url":"%s","message":"%s"}\n' \
        "$(json_escape "$installed")" "$via_opkg" "$(json_escape "$UPD_LATEST")" "$avail" \
        "$(json_escape "$UPD_RELEASE_URL")" "$(json_escape "$msg")"
}

# One JSON reply line for update-start.
upd_reply() {   # status message
    printf '{"status":"%s","message":"%s"}\n' "$1" "$(json_escape "$2")"
}

# The two fixed paths must be absent or regular files: a symlink planted there by a local process would
# otherwise be followed by root.
upd_state_paths_ok() {
    local p
    for p in "$UPD_STATUS" "$UPD_LOCK"; do
        if [ -L "$p" ] || { [ -e "$p" ] && [ ! -f "$p" ]; }; then return 1; fi
    done
    return 0
}

# Written atomically beside the status path, then moved over it: a reader never sees a partial file, and a
# symlink at the path is replaced rather than followed. Only printable ASCII reaches the JSON string.
upd_set_status() {   # status message
    local tmp
    tmp=$(mktemp "$UPD_STATUS.XXXXXX") || return 1
    printf '{"status":"%s","message":"%s"}\n' "$1" "$(json_escape "$(printf '%s' "$2" | tr -cd ' -~')")" > "$tmp" \
        && mv -f "$tmp" "$UPD_STATUS"
}

# Guaranteed terminal state: a worker that dies mid-step (set -e, a killed curl) would otherwise leave
# "running" behind and the dialog would spin forever. The working directory goes; the status file stays
# for the UI to read.
upd_cleanup() {
    if grep -q '"status":"running"' "$UPD_STATUS" 2>/dev/null; then
        upd_set_status error "Interrupted during: ${UPD_STEP:-start} - check the network and retry"
    fi
    [ -n "$UPD_DIR" ] && rm -rf "$UPD_DIR"
}

cmd_update_start() {
    local fetch_only="" rc err dir
    case "${1:-}" in
        '') ;;
        --fetch-only) fetch_only="--fetch-only" ;;
        *) upd_reply error "Unknown option: $1"; return 0 ;;
    esac
    upd_state_paths_ok || { upd_reply error "Unexpected file at $UPD_STATE.status or $UPD_STATE.lock - remove it and retry"; return 0; }
    # Probe the lock without keeping it: rc 1 means a worker holds it; anything else is a broken lock
    # mechanism and is reported as such rather than mistaken for a running update.
    rc=0; err=$( ( exec 9>>"$UPD_LOCK"; flock -n 9 ) 2>&1 ) || rc=$?
    if [ "$rc" -eq 1 ]; then upd_reply error "An update is already running"; return 0; fi
    [ "$rc" -eq 0 ] || { upd_reply error "Cannot take the update lock (exit $rc): ${err:-no details}"; return 0; }
    dir=$(mktemp -d "${TMPDIR:-/tmp}/gl-portable-backup-update.XXXXXX") || { upd_reply error "Cannot create a working directory"; return 0; }
    cp "$0" "$dir/worker.sh" 2>/dev/null || { rm -rf "$dir"; upd_reply error "Cannot stage the update worker"; return 0; }
    upd_set_status running "Starting..." || { rm -rf "$dir"; upd_reply error "Cannot write the status file"; return 0; }
    # Detached: GL's BusyBox has no nohup or setsid; an orphaned subshell with its stdio closed outlives
    # the rpcd exec call that started it (verified on firmware 4.11). The copy, not this file, does the work.
    ( GPB_LIB_ONLY= GPB_UPDATE_DIR="$dir" GPB_UPDATE_STATE="$UPD_STATE" GPB_UPDATE_API_URL="$UPD_API_URL" GPB_UPDATE_BASE_URL="$UPD_BASE_URL" \
      sh "$dir/worker.sh" update-install $fetch_only </dev/null >"$dir/worker.log" 2>&1 & )
    upd_reply started ""
}

cmd_update_install() {
    local fetch_only="" installed ver ipk free_kb rc code pkgver now
    case "${1:-}" in
        '') ;;
        --fetch-only) fetch_only=1 ;;
        *) die "update-install: unknown option: $1" ;;
    esac
    upd_state_paths_ok || die "update-install: unexpected file at $UPD_STATE.status or $UPD_STATE.lock"
    if [ -z "$UPD_DIR" ]; then
        UPD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/gl-portable-backup-update.XXXXXX") || die "update-install: cannot create a working directory"
    fi
    exec 9>>"$UPD_LOCK"
    rc=0; flock -n 9 || rc=$?
    if [ "$rc" -eq 1 ]; then rm -rf "$UPD_DIR"; exit 0; fi          # another worker owns the status file: say nothing
    [ "$rc" -eq 0 ] || { upd_set_status error "Cannot take the update lock (flock exit $rc)"; rm -rf "$UPD_DIR"; exit 1; }
    trap upd_cleanup EXIT
    trap 'exit 1' INT TERM
    UPD_STEP="checking the latest version"; upd_set_status running "Checking the latest version..."
    upd_query_latest 2>"$UPD_DIR/query.err" || { upd_set_status error "$(head -n 1 "$UPD_DIR/query.err" | sed 's/^update: //')"; exit 1; }
    [ -n "$UPD_LATEST" ] || { upd_set_status error "No stable release is published yet"; exit 1; }
    ver="$UPD_LATEST"
    if [ -z "$fetch_only" ]; then
        installed=$(upd_installed_version) || installed=""
        [ -n "$installed" ] || { upd_set_status error "The plugin is not installed through opkg - self-update is unavailable"; exit 1; }
        ver_gt "$ver" "$installed" || { upd_set_status success "Already up to date ($installed)"; exit 0; }
    fi
    ipk="${UPD_PKG}_${ver}_all.ipk"
    UPD_STEP="checking free space"
    free_kb=$(df -k "$ROOT/overlay" 2>/dev/null | tail -n 1 | awk '{print $4}') || free_kb=""
    if [ -n "$free_kb" ] && [ "$free_kb" -lt 2048 ] 2>/dev/null; then
        upd_set_status error "Not enough free space on /overlay (${free_kb} KB free, 2048 KB needed)"; exit 1
    fi
    UPD_STEP="downloading $ipk"; upd_set_status running "Downloading version $ver..."
    rc=0; code=$(curl -fsSL --connect-timeout 15 --max-time 300 -o "$UPD_DIR/$ipk" -w '%{http_code}' "$UPD_BASE_URL/v$ver/$ipk") || rc=$?
    [ "$rc" -eq 0 ] || { upd_set_status error "Download of $ipk failed (HTTP ${code:-000}, curl exit $rc)"; exit 1; }
    rc=0; code=$(curl -fsSL --connect-timeout 15 --max-time 60 -o "$UPD_DIR/SHA256SUMS" -w '%{http_code}' "$UPD_BASE_URL/v$ver/SHA256SUMS") || rc=$?
    [ "$rc" -eq 0 ] || { upd_set_status error "Download of SHA256SUMS failed (HTTP ${code:-000}, curl exit $rc)"; exit 1; }
    UPD_STEP="verifying the checksum"; upd_set_status running "Verifying the checksum..."
    # Only the line for this exact asset counts (SHA256SUMS also lists the _latest_ alias).
    awk -v n="$ipk" '$2 == n' "$UPD_DIR/SHA256SUMS" > "$UPD_DIR/expected.sums"
    [ -s "$UPD_DIR/expected.sums" ] || { upd_set_status error "SHA256SUMS carries no entry for $ipk"; exit 1; }
    ( cd "$UPD_DIR" && sha256sum -c expected.sums >/dev/null 2>&1 ) || { upd_set_status error "Checksum mismatch for $ipk - the download was rejected"; exit 1; }
    UPD_STEP="checking the package version"
    # The control file's Version must be the release's: a stale or swapped asset is rejected here.
    pkgver=$(tar -xzOf "$UPD_DIR/$ipk" ./control.tar.gz 2>/dev/null | tar -xzOf - 2>/dev/null | sed -n 's/^Version: //p' | head -n 1) || pkgver=""
    [ "$pkgver" = "$ver" ] || { upd_set_status error "The package says version '${pkgver:-?}' but the release is $ver - rejected"; exit 1; }
    if [ -n "$fetch_only" ]; then
        upd_set_status success "Verified $ipk (version $ver); install skipped (--fetch-only)"; exit 0
    fi
    UPD_STEP="installing version $ver"; upd_set_status running "Installing version $ver..."
    # No force flags: a same-or-lower version must fail here rather than downgrade or reinstall.
    if ! opkg install "$UPD_DIR/$ipk" > "$UPD_DIR/opkg.log" 2>&1; then
        upd_set_status error "opkg install failed: $(tail -n 1 "$UPD_DIR/opkg.log" | head -c 200)"; exit 1
    fi
    now=$(upd_installed_version) || now=""
    [ "$now" = "$ver" ] || { upd_set_status error "opkg reported success but the installed version is '${now:-?}', not $ver"; exit 1; }
    upd_set_status success "Updated to $ver - reload this page to use the new version"
}

cmd_update_status() {
    if [ -L "$UPD_STATUS" ] || { [ -e "$UPD_STATUS" ] && [ ! -f "$UPD_STATUS" ]; }; then
        upd_reply error "Unexpected file at $UPD_STATUS"
    elif [ -f "$UPD_STATUS" ]; then
        cat "$UPD_STATUS"
    else
        echo '{"status":"idle","message":""}'
    fi
}

# ─── Main ──────────────────────────────────────────────────────────────────────

# Library mode for tests: source with GPB_LIB_ONLY=1 and call functions directly.
if [ "${GPB_LIB_ONLY:-0}" = 1 ]; then return 0 2>/dev/null || exit 0; fi

case "${1:-}" in
    -v|--verbose) GPB_VERBOSE=1; shift ;;
esac

case "${1:-}" in
    create)
        shift
        cmd_create "$@"
        ;;
    restore)
        shift
        cmd_restore "$@"
        ;;
    inspect)
        shift
        cmd_inspect "$@"
        ;;
    fingerprint)
        shift
        cmd_fingerprint "$@"
        ;;
    packages)
        shift
        cmd_packages "$@"
        ;;
    install-package)
        shift
        cmd_install_package "$@"
        ;;
    update-check)
        shift
        cmd_update_check "$@"
        ;;
    update-start)
        shift
        cmd_update_start "$@"
        ;;
    update-install)
        shift
        cmd_update_install "$@"
        ;;
    update-status)
        cmd_update_status
        ;;
    version)
        echo "${TOOL_NAME} ${VERSION}"
        ;;
    *)
        echo "Usage: gl-portable-backup {create|restore|inspect|fingerprint|packages|install-package|update-check|update-start|update-install|update-status|version}" >&2
        echo "" >&2
        echo "Commands:" >&2
        echo "  create           Create a backup archive" >&2
        echo "  restore          Restore from a backup archive [--keep-host-keys]" >&2
        echo "  inspect          Show manifest from a backup archive" >&2
        echo "  fingerprint      Show the SSH host-key fingerprint an archive would install" >&2
        echo "  packages         Compare archive packages vs this device" >&2
        echo "  install-package  Install a single package via opkg" >&2
        echo "  update-check     Report the installed and the newest stable release version (JSON)" >&2
        echo "  update-start     Start a detached self-update to the newest stable release [--fetch-only]" >&2
        echo "  update-install   The update worker itself (normally started by update-start) [--fetch-only]" >&2
        echo "  update-status    Show the running or last update's status (JSON)" >&2
        echo "  version          Show version" >&2
        echo "" >&2
        echo "Options:" >&2
        echo "  -v, --verbose    Print each local API call (put before the command)" >&2
        echo "  --keep-host-keys Keep this device's SSH host keys during a restore" >&2
        exit 1
        ;;
esac
