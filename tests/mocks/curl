#!/bin/sh
# mock curl: records the -d payload, replies from $MOCK_CURL_DIR/<key>.json, exit code $MOCK_CURL_EXIT.
# $MOCK_CURL_FAIL_KEY fails one call only — the one whose <module>.<method> key matches — with
# exit 22, which is what `curl -f` returns for an HTTP status of 400 or above.
data=""
while [ $# -gt 0 ]; do case "$1" in -d) data="$2"; shift 2;; *) shift;; esac; done
printf '%s\n' "$data" >> "${MOCK_CURL_LOG:-/dev/null}"
[ "${MOCK_CURL_EXIT:-0}" != 0 ] && exit "$MOCK_CURL_EXIT"
key=$(printf '%s' "$data" | sed -n 's/.*"method":"\([a-z]*\)".*/\1/p')
if [ "$key" = call ]; then key=$(printf '%s' "$data" | sed -n 's/.*"params":\["[^"]*","\([^"]*\)","\([^"]*\)".*/\1.\2/p'); fi
[ -n "${MOCK_CURL_FAIL_KEY:-}" ] && [ "$key" = "$MOCK_CURL_FAIL_KEY" ] && exit 22
f="${MOCK_CURL_DIR:-.}/$key.json"
if [ -f "$f" ]; then cat "$f"; else printf '{"id":1,"jsonrpc":"2.0","error":{"code":-32601,"message":"Method not found"}}'; fi
